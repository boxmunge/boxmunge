#!/usr/bin/env bash
# shellcheck disable=SC2034  # constants below are used by the sourced libraries
# boxmunge-upgrade — orchestrates platform upgrades with rollback safety.
#
# This script is intentionally simple and self-contained. It NEVER imports
# Python code — it only calls Python commands as subprocesses and checks
# exit codes. This ensures rollback works even if the new code is broken.
#
# Entry points (deploy may sudo only the two marked *; see install-sudoers):
# * auto                       discover the latest release and upgrade to it
# * target <version>           upgrade to a specific newer, non-blocklisted version
#   force-target <version>     operator only: ignore the blocklist and downgrade floor
#   run <version> <url>        auto-update timer: upgrade to a discovered version
#                              (the bundle URL is always derived from <version>)
#   check-probation            health timer: promote or roll back a probation
#   clear-blocklist <version>  operator only: forget a failed version
#   install-sudoers            install.sh and upgrades: (re)write deploy's sudo rule
#   install-docs <dir>         install.sh and upgrades: replace docs/ with <dir>/*.md
#
# In the source tree the functions live in boxmunge-upgrade.d/ (state, slots,
# probation, system). The release build (scripts/build-shim.py) inlines them,
# so the shim a box runs is this one self-contained file: whatever installs it
# (install.sh, or an older release's shim self-updating) copies only this file.
#
# Cross-version contract: the crash-safety markers (upgrade-inflight,
# rollback-inflight; see slots.sh) may be left by this shim and found by a
# later one. Every later shim must honour them before it deletes any slot.

set -euo pipefail

BOXMUNGE_ROOT="${BOXMUNGE_ROOT:-/opt/boxmunge}"
STATE_DIR="$BOXMUNGE_ROOT/upgrade-state"
LOCK_FILE="$STATE_DIR/upgrade.lock"
ACTIVE_SLOT_FILE="$STATE_DIR/active-slot"
BLOCKLIST_FILE="$STATE_DIR/blocklist.json"
PROBATION_FILE="$STATE_DIR/probation.json"
# Root-only (BOXMUNGE_ROOT is root:root 0755); see failure_count in state.sh.
UPGRADE_ROOT_DIR="$BOXMUNGE_ROOT/upgrade-root"
INTERRUPTED_FILE="$UPGRADE_ROOT_DIR/interrupted.json"
PIP_FAILURES_FILE="$UPGRADE_ROOT_DIR/pip-failures.json"
# The last release whose bundle has no requirements-mcp.txt. Every install
# needs it, so this shim cannot install that release or any before it.
LAST_RELEASE_WITHOUT_MCP_LOCK="0.10.1"
PROBATION_HOURS=6
BIN_DIR="$BOXMUNGE_ROOT/bin"
VERSION_FILE="$BOXMUNGE_ROOT/config/version"
SUDOERS_FILE="${BOXMUNGE_SUDOERS_FILE:-/etc/sudoers.d/boxmunge-deploy}"

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) boxmunge-upgrade: $*" >&2; }
die() { log "FATAL: $*"; exit 1; }

# bm_log <level> <component> <msg> [<detail-json>]
#
# Best-effort write to /opt/boxmunge/logs/boxmunge.log via the active venv's
# Python (so `boxmunge log` surfaces shim phase events alongside everything
# else). The shim is the operator's only recovery surface — a logging
# failure must not crash the upgrade — so the body is wrapped in
# `2>/dev/null || true`.
#
# Levels: info | warn | error. Detail JSON defaults to {}.
bm_log() {
    local level="$1" component="$2" msg="$3" detail="${4:-"{}"}"
    BM_LEVEL="$level" BM_COMPONENT="$component" BM_MSG="$msg" BM_DETAIL="$detail" \
        "$(active_venv)/bin/python" - <<'PYBM' 2>/dev/null || true
import json, os
from boxmunge.paths import BoxPaths
from boxmunge.log import log_operation, log_warning, log_error
fns = {"info": log_operation, "warn": log_warning, "error": log_error}
fn = fns.get(os.environ["BM_LEVEL"], log_operation)
try:
    detail = json.loads(os.environ["BM_DETAIL"])
except Exception:
    detail = {"raw": os.environ.get("BM_DETAIL", "")}
fn(os.environ["BM_COMPONENT"], os.environ["BM_MSG"], BoxPaths(), detail=detail)
PYBM
}

# >>> boxmunge-upgrade.d: the source loader; scripts/build-shim.py replaces
# this block with the libraries themselves.
SHIM_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/boxmunge-upgrade.d"
[[ -d "$SHIM_LIB_DIR" ]] \
    || die "This is the unbuilt source shim and $SHIM_LIB_DIR is missing; install a release bundle, whose shim is built"
for lib in state slots probation system; do
    # shellcheck source=/dev/null
    source "$SHIM_LIB_DIR/$lib.sh"
done
# <<< boxmunge-upgrade.d

# preflight_fail <version> <from_version> <blocklist_reason> <message> [stage]
#
# Abort before the slot swap: drop the half-built standby venv, blocklist
# the version so auto-update stops retrying it, and report the failure.
preflight_fail() {
    log "$4"
    remove_slot "$(standby_slot)"
    add_blocklist "$1" "$3"
    report_failure "$1" "$2" "${5:-preflight}"
    exit 1
}

# dependency_install_failed <version> <from_version>: pip could not install
# the bundle's hash-pinned dependencies. That is rarely the release's fault
# (a network blip, the disk filling mid-install), so, as for an interrupted
# upgrade, the first failure of a version is not blocklisted or reported to
# the fleet service and auto-update retries it; a second in a row is.
dependency_install_failed() {
    local version="$1" from_version="$2" count
    count=$(( $(pip_failures "$version") + 1 ))
    pip_failures "$version" "$count"
    [[ "$count" -lt 2 ]] || preflight_fail "$version" "$from_version" "preflight_failed: pip_install_deps" \
        "Failed to install hash-pinned dependencies from bundle ($count times in a row); blocklisting $version"
    log "Failed to install hash-pinned dependencies from bundle; not blocklisted, auto-update will retry $version"
    remove_slot "$(standby_slot)"
    bm_log warn upgrade "dependency install failed" "{\"version\": \"$version\", \"failures\": $count}"
    send_notification "boxmunge upgrade failed" "Could not install the dependencies of $version (not blocklisted; auto-update will retry it)"
    exit 1
}

# stash_failed <version> <output>: the platform stash was refused (a symlink
# it cannot hold) or failed (a full disk) before anything changed. That is the
# box's doing, not the release's, so the version is not blocklisted or
# reported; the standby is dropped and the operator alerted, so an unattended
# auto-update stopping here every run is seen.
stash_failed() {
    local version="$1" output="$2"
    log "Stash creation failed, aborting; $version not blocklisted: $output"
    remove_slot "$(standby_slot)"
    bm_log error upgrade "upgrade to $version aborted before any change: stash creation failed: $output" \
        "{\"version\": \"$version\"}"
    send_notification "boxmunge upgrade failed" \
        "The platform stash failed, so the upgrade to $version stopped before changing anything (not blocklisted; auto-update will retry it). Fix this and retry: $output"
    exit 1
}

TMP_DOWNLOAD=""
cleanup_download() { [[ -z "$TMP_DOWNLOAD" ]] || rm -rf "$TMP_DOWNLOAD"; }

cmd_run() {
    local version="${1:?Usage: boxmunge-upgrade run <version> <url>}"
    : "${2:?Usage: boxmunge-upgrade run <version> <url>}"
    upgrade_to "$version" run
}

# upgrade_to <version> <mode>: the upgrade itself, after the policy check.
upgrade_to() {
    local version="$1" mode="$2"

    load_active_slot
    acquire_lock
    check_policy "$version" "$mode"
    refuse_during_probation "$version" "$mode"
    cmd_install_sudoers
    seed_slot_docs "$ACTIVE_SLOT"

    local prev_slot from_version standby
    prev_slot="$ACTIVE_SLOT"
    from_version="$("$(active_venv)/bin/boxmunge-server" --version 2>/dev/null || echo "unknown")"
    standby="$(standby_slot)"

    # 1. PREPARE
    log "Preparing standby venv (slot $standby)..."
    # A slot is about 90MB on Debian, MCP included. pip runs with
    # --no-cache-dir, so no wheel cache builds up under /root; the rest is
    # headroom for the stash.
    local avail_mb
    avail_mb=$(df -m "$BOXMUNGE_ROOT" | awk 'NR==2{print $4}')
    [[ "$avail_mb" -lt 250 ]] && die "Insufficient disk space: ${avail_mb}MB available, need 250MB"

    remove_slot "$standby"
    python3 -m venv "$BOXMUNGE_ROOT/env-$standby"

    # Download bundle from GitHub release
    local tmp_download
    TMP_DOWNLOAD="$(mktemp -d)"
    tmp_download="$TMP_DOWNLOAD"
    trap cleanup_download EXIT
    local release_base="https://github.com/boxmunge/boxmunge/releases/download/v${version}"
    local bundle_url="${release_base}/boxmunge-${version}.tar.gz"
    local sums_url="${release_base}/SHA256SUMS"
    local sums_sig_url="${release_base}/SHA256SUMS.sig"
    local sums_cert_url="${release_base}/SHA256SUMS.cert"

    log "Downloading bundle from ${bundle_url}"
    curl -sLf -o "$tmp_download/boxmunge-${version}.tar.gz" "$bundle_url" \
        || preflight_fail "$version" "$from_version" "preflight_failed: bundle_download" \
            "Failed to download bundle"
    curl -sLf -o "$tmp_download/SHA256SUMS" "$sums_url" \
        || preflight_fail "$version" "$from_version" "preflight_failed: checksum_download" \
            "Failed to download SHA256SUMS"
    curl -sLf -o "$tmp_download/SHA256SUMS.sig" "$sums_sig_url" \
        || preflight_fail "$version" "$from_version" "preflight_failed: signature_download" \
            "Failed to download SHA256SUMS.sig (release is unsigned or sig artifact missing)"
    curl -sLf -o "$tmp_download/SHA256SUMS.cert" "$sums_cert_url" \
        || preflight_fail "$version" "$from_version" "preflight_failed: certificate_download" \
            "Failed to download SHA256SUMS.cert (release is unsigned or cert artifact missing)"

    # Verify cosign signature on SHA256SUMS BEFORE running sha256sum -c.
    #
    # This breaks the circularity of the prior design (where SHA256SUMS and
    # the bundle came from the same release URL — an attacker who replaced
    # the bundle could replace SHA256SUMS in lockstep). Cosign's keyless
    # signature chains to a Fulcio cert tying SHA256SUMS to the release
    # workflow on a tagged release of this exact repo; without the OIDC
    # issuer pinning the attacker would need to compromise GitHub Actions
    # OIDC, not just the release artifacts.
    #
    # cosign is hard-required: if the host is missing it, abort.
    if ! verify_release_signature "$tmp_download"; then
        preflight_fail "$version" "$from_version" "preflight_failed: cosign_verify" \
            "Cosign verification of SHA256SUMS FAILED — refusing to install."
    fi
    log "Cosign signature on SHA256SUMS verified (release-workflow identity)"
    bm_log info upgrade "signature verified" "{\"version\": \"$version\"}"

    # Verify checksum.
    #
    # SHA256SUMS lines are produced by `sha256sum <file>` and have the
    # canonical form: `<64-hex-hash>  <filename>` (two spaces, bare filename
    # — the release workflow takes care to write bare filenames).
    #
    # We do NOT pass --ignore-missing: it makes `sha256sum -c` succeed when
    # the SHA256SUMS file lists zero matching files. An adversary who could
    # publish a SHA256SUMS without a line for our bundle would then pass
    # verification trivially. So instead we (a) require that SHA256SUMS
    # contains a line for the exact bundle filename we just downloaded, and
    # (b) run the full check.
    local expected_filename="boxmunge-${version}.tar.gz"
    if ! grep -q "  ${expected_filename}\$" "${tmp_download}/SHA256SUMS"; then
        preflight_fail "$version" "$from_version" "preflight_failed: checksum_missing_entry" \
            "Checksum verification FAILED: SHA256SUMS does not list ${expected_filename}"
    fi
    # SHA256SUMS may also list boxmunge-install.sh and other release artefacts
    # we did not download; restrict the check to just the bundle line.
    (cd "$tmp_download" && grep "  ${expected_filename}\$" SHA256SUMS | sha256sum -c -) \
        || preflight_fail "$version" "$from_version" "preflight_failed: checksum_mismatch" \
            "Checksum verification FAILED"

    # Extract and pip install
    tar xzf "$tmp_download/boxmunge-${version}.tar.gz" -C "$tmp_download"
    # Dependencies only from the bundle's hash-pinned requirements (covered by
    # the signed SHA256SUMS); the package itself with no further resolution,
    # built by the hash-pinned backend. No pip self-upgrade: one more
    # unpinned download. MCP is part of every install: the slot is built from
    # scratch, so anything not installed here is gone after the swap.
    local bundle="$tmp_download/boxmunge" req reqs=()
    for req in requirements-build.txt requirements-tui.txt requirements-mcp.txt; do
        [[ -f "$bundle/$req" ]] \
            || preflight_fail "$version" "$from_version" "preflight_failed: no_pinned_requirements" \
                "Bundle has no hash-pinned $req; refusing an unpinned install"
        reqs+=(-r "$bundle/$req")
    done
    "$BOXMUNGE_ROOT/env-$standby/bin/pip" install --quiet --no-cache-dir --require-hashes "${reqs[@]}" \
        || dependency_install_failed "$version" "$from_version"
    pip_failures "$version" 0
    "$BOXMUNGE_ROOT/env-$standby/bin/pip" install --quiet --no-cache-dir --no-deps --no-build-isolation "$bundle" \
        || preflight_fail "$version" "$from_version" "preflight_failed: pip_install" \
            "Failed to install boxmunge from bundle"
    compgen -G "$tmp_download/boxmunge/on-server/*.md" >/dev/null \
        || preflight_fail "$version" "$from_version" "preflight_failed: bundle_docs" \
            "Bundle has no on-server/*.md docs"
    mkdir -p "$(slot_docs "$standby")"
    cp "$tmp_download/boxmunge/on-server/"*.md "$(slot_docs "$standby")/"

    # 2. PRE-FLIGHT
    log "Running pre-flight checks..."

    # Pre-flight import test: verify the new venv can import boxmunge and
    # report a non-empty version. v0.9.0 dropped the stale
    # `boxmunge.__version__` constant (drift-prone, not actually the source
    # of truth) — read from `boxmunge.version.get_build_version()` instead,
    # which has been the canonical accessor since v0.5.
    "$BOXMUNGE_ROOT/env-$standby/bin/python" -c "from boxmunge.version import get_build_version; print(get_build_version())" \
        || preflight_fail "$version" "$from_version" "preflight_failed: import" \
            "Pre-flight FAILED: import test"

    "$BOXMUNGE_ROOT/env-$standby/bin/boxmunge-server" --version >/dev/null 2>&1 \
        || preflight_fail "$version" "$from_version" "preflight_failed: cli_version" \
            "Pre-flight FAILED: CLI version check"

    "$BOXMUNGE_ROOT/env-$standby/bin/boxmunge-server" upgrade --dry-run \
        || preflight_fail "$version" "$from_version" "preflight_failed: dry_run" \
            "Pre-flight FAILED: dry-run upgrade"

    log "Pre-flight passed"

    # 3. STASH (using active/trusted venv)
    log "Creating platform stash..."
    local stash_out
    stash_out="$("$(active_venv)/bin/boxmunge-server" stash create 2>&1)" \
        || stash_failed "$version" "$stash_out"
    log "$stash_out"

    # 3a. Refresh tree-level templates that aren't shipped in the venv.
    # Today: the canary project, used by `boxmunge self-test`. Without this,
    # an auto-updated host has no /opt/boxmunge/canary and self-test errors.
    # Runs as root; perms aren't a concern. Overwrite any prior dir.
    if [[ -d "$tmp_download/boxmunge/canary" ]]; then
        log "Refreshing /opt/boxmunge/canary from bundle..."
        rm -rf "$BOXMUNGE_ROOT/canary"
        cp -r "$tmp_download/boxmunge/canary" "$BOXMUNGE_ROOT/canary"
        chown -R root:root "$BOXMUNGE_ROOT/canary"
        bm_log info upgrade "canary refreshed" "{\"version\": \"$version\"}"
    fi

    # 3b. Self-update the upgrade shim and its libraries (see self_update_shim).
    self_update_shim "$tmp_download/boxmunge"

    # 3c. System upgrade (install.sh re-run).
    #
    # Closes the v0.6.x gap where new system deps (Trivy, new systemd timers,
    # apt packages) silently required a manual install.sh re-run after every
    # auto-update. install.sh writes its own sha256 to state/installer.sha256
    # at the end of every successful run — when the bundled install.sh differs
    # from the on-disk fingerprint, we re-invoke it BEFORE the slot swap so
    # system-level dependencies are in place by the time the new venv goes
    # active. install.sh is hard-gated on `bash -n` for the same reason as
    # the shim self-update above: a syntactically broken install.sh in a
    # future release must NOT brick this host.
    #
    # On install.sh failure: fail noisily before the swap, blocklist this
    # version, and exit. The prior venv stays active and the prior shim
    # stays in place (we already swapped the shim above, but the new shim
    # is meant to be backwards-compatible with the old layout). Operator
    # diagnoses, fixes manually, and clears the blocklist.
    #
    # Missing-fingerprint case (first upgrade past this feature): treated
    # as "needs upgrade" — install.sh re-runs, writes the fingerprint, and
    # subsequent upgrades only re-run when the bundle changes install.sh.
    local new_install_sh="$tmp_download/boxmunge/install.sh"
    local installer_hash_file="$BOXMUNGE_ROOT/state/installer.sha256"
    if [[ -f "$new_install_sh" ]]; then
        if ! bash -n "$new_install_sh" 2>/dev/null; then
            bm_log error upgrade "system upgrade skipped: bash -n failed" "{\"version\": \"$version\"}"
            preflight_fail "$version" "$from_version" "system_upgrade_failed: install_sh_syntax" \
                "ERROR: bundled install.sh has syntax errors; refusing to run system upgrade" system_upgrade
        fi
        local new_hash current_hash
        new_hash="$(sha256sum "$new_install_sh" | awk '{print $1}')"
        current_hash="$(cat "$installer_hash_file" 2>/dev/null || echo "")"
        if [[ "$new_hash" != "$current_hash" ]]; then
            log "install.sh changed (current=${current_hash:0:8}, new=${new_hash:0:8}); running system upgrade..."
            bm_log info upgrade "system upgrade started" "{\"new_hash\": \"${new_hash:0:16}\", \"prev_hash\": \"${current_hash:0:16}\"}"
            local sysup_exit=0
            bash "$new_install_sh" --upgrade-shim || sysup_exit=$?
            if [[ "$sysup_exit" -eq 0 ]]; then
                bm_log info upgrade "system upgrade completed" "{\"hash\": \"${new_hash:0:16}\"}"
            else
                bm_log error upgrade "system upgrade failed" "{\"exit_code\": $sysup_exit}"
                preflight_fail "$version" "$from_version" "system_upgrade_failed: install_sh_exit_${sysup_exit}" \
                    "ERROR: install.sh failed (exit ${sysup_exit}); aborting upgrade before slot swap" system_upgrade
            fi
        else
            log "install.sh unchanged (${new_hash:0:8}); skipping system upgrade"
        fi
    fi

    # 4. SWAP. Until probation is recorded, the marker is what keeps
    # check-probation from deleting the previous slot as an orphan after a
    # crash; it is synced to disk before the new slot can go live.
    echo "$version" > "$(inflight_marker "$standby")"
    sync
    log "Swapping to standby venv (slot $standby)..."
    swap_to "$standby"

    # 5. APPLY (using new active venv)
    log "Applying upgrade..."
    "$(active_venv)/bin/boxmunge-server" upgrade --apply || {
        do_rollback "$version" "$from_version" "apply" "$prev_slot"
    }

    # 6. VERIFY
    log "Running health check..."
    # Bound the immediate post-swap health check. A wedged docker socket
    # or stuck subprocess could otherwise hang here indefinitely. Use
    # --kill-after=10 to escalate SIGTERM -> SIGKILL if the process refuses
    # to die. Budget is shorter than probation's 180s because this is the
    # post-swap quick check; probation does the long-running validation.
    local health_exit=0
    timeout --kill-after=10 60 "$(active_venv)/bin/boxmunge-server" health --json >/dev/null 2>&1 || health_exit=$?
    if [[ "$health_exit" -eq 2 ]]; then
        do_rollback "$version" "$from_version" "health_immediate" "$prev_slot"
    fi

    # 7. ENTER PROBATION
    log "Entering probation for $version..."
    BM_VERSION="$version" BM_PREV_SLOT="$prev_slot" BM_HOURS="$PROBATION_HOURS" "$(active_venv)/bin/python" -c "
import os
from boxmunge.upgrade_state import write_probation
from boxmunge.paths import BoxPaths
write_probation(BoxPaths(), os.environ['BM_VERSION'], os.environ['BM_PREV_SLOT'], hours=int(os.environ['BM_HOURS']))
"
    bm_log info upgrade "probation entered" "{\"version\": \"$version\", \"prev_slot\": \"$prev_slot\", \"hours\": $PROBATION_HOURS}"
    rm -f "$(inflight_marker "$ACTIVE_SLOT")"
    refresh_docs_for_slot "$ACTIVE_SLOT"

    send_notification "boxmunge security update applied" "Updated to $version (probation: ${PROBATION_HOURS}h)"
    log "Upgrade to $version complete, probation started"
    exit 0
}

cmd_auto() {
    local result action version msg
    load_active_slot
    acquire_lock  # before discovery, and held through the upgrade itself
    result="$("$(active_venv)/bin/boxmunge-server" _discover-update --json 2>/dev/null)" || \
        die "Discovery failed (boxmunge-server _discover-update returned non-zero)"

    action="$(echo "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("action",""))')"

    case "$action" in
        upgrade)
            version="$(echo "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin)["version"])')"
            log "Manual upgrade: discovered $(printable "$version")"
            upgrade_to "$version" run
            ;;
        up_to_date)
            log "Already on latest version"
            exit 0
            ;;
        blocklisted)
            log "Latest version is blocklisted on this box; nothing to do"
            exit 0
            ;;
        error)
            msg="$(echo "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("message","(no message)"))')"
            die "Discovery error: $msg"
            ;;
        *)
            die "Unknown action from _discover-update: $action"
            ;;
    esac
}

# target <version>: reachable by deploy through sudo, so exactly one argument
# (sudo's `target *` would otherwise let extra words through).
cmd_target() {
    [[ $# -eq 1 ]] || die "Usage: boxmunge-upgrade target <version>"
    require_semver "$1" "requested version"
    log "Targeted upgrade: $1"
    upgrade_to "$1" target
}

cmd_force_target() {
    [[ $# -eq 1 ]] || die "Usage: boxmunge-upgrade force-target <version>"
    require_semver "$1" "requested version"
    log "Operator-forced upgrade: $1"
    upgrade_to "$1" force
}

cmd_clear_blocklist() {
    local version="${1:?Usage: boxmunge-upgrade clear-blocklist <version>}"
    require_semver "$version" "requested version"
    load_active_slot
    BM_VERSION="$version" "$(active_venv)/bin/python" -c "
import os
from boxmunge.upgrade_state import remove_from_blocklist
from boxmunge.paths import BoxPaths
remove_from_blocklist(BoxPaths(), os.environ['BM_VERSION'])
"
    interruptions "$version" 0
    pip_failures "$version" 0
    log "Cleared $version from blocklist"
}

case "${1:-}" in
    run)             shift; cmd_run "$@" ;;
    auto)            [[ $# -eq 1 ]] || die "Usage: boxmunge-upgrade auto"; cmd_auto ;;
    target)          shift; cmd_target "$@" ;;
    force-target)    shift; cmd_force_target "$@" ;;
    check-probation) cmd_check_probation ;;
    clear-blocklist) shift; cmd_clear_blocklist "$@" ;;
    install-sudoers) cmd_install_sudoers ;;
    install-docs)    shift; cmd_install_docs "$@" ;;
    *)               die "Usage: boxmunge-upgrade {run|auto|target|force-target|check-probation|clear-blocklist|install-sudoers|install-docs} [args]" ;;
esac
