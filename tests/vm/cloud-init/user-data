#cloud-config
users:
  - name: test
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - __SSH_PUBLIC_KEY__

# The VM's only host key, generated by vm-test.py and already trusted in
# known_hosts, so nothing has to scan for it.
__HOST_KEY_CONFIG__

# Do NOT run package_update — init-host.sh does its own apt update
# and the two would race for the apt lock.
package_update: false
package_upgrade: false
