#!/usr/bin/env bash
# shellcheck disable=SC2034  # constants below are used by the sourced libraries
# boxmunge-upgrade — orchestrates platform upgrades with rollback safety.
#
# This script is intentionally simple and self-contained. It NEVER imports
# Python code — it only calls Python commands as subprocesses and checks
# exit codes. This ensures rollback works even if the new code is broken.
#
# Entry points (deploy may sudo only the two marked *; see install-sudoers):
# * auto                       discover the latest release and upgrade to it
# * target <version>           upgrade to a specific newer, non-blocklisted version
#   force-target <version>     operator only: ignore the blocklist and downgrade floor
#   run <version> <url>        auto-update timer: upgrade to a discovered version
#                              (the bundle URL is always derived from <version>)
#   check-probation            health timer: promote or roll back a probation
#   clear-blocklist <version>  operator only: forget a failed version
#   install-sudoers            install.sh and upgrades: (re)write deploy's sudo rule
#   install-docs <dir>         install.sh and upgrades: replace docs/ with <dir>/*.md
#   userns-migrate [--check]   operator only: remap the Docker daemon (check: read-only report)
#   userns-rollback            operator only: undo an uncommitted or interrupted migration
#   userns-commit              operator only: delete the old root after the soak
#
# In the source tree the functions live in boxmunge-upgrade.d/ (state, slots,
# probation, system, userns). The release build (scripts/build-shim.py)
# inlines them, so the shim a box runs is this one self-contained file:
# whatever installs it (install.sh, or an older release's shim
# self-updating) copies only this file.
#
# Cross-version contract: the crash-safety markers (upgrade-inflight,
# rollback-inflight; see slots.sh) may be left by this shim and found by a
# later one. Every later shim must honour them before it deletes any slot.

set -euo pipefail

# Root starts in the caller's directory (sudo keeps it), which deploy may
# control, and `python3 -c` / `python3 -` put the working directory first on
# sys.path, so a planted json.py there would run as root. Leave it, and keep
# every Python this shim runs from importing from it.
SHIM_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
SHIM_ARGS=("$@")
cd /
export PYTHONSAFEPATH=1

BOXMUNGE_ROOT="${BOXMUNGE_ROOT:-/opt/boxmunge}"
STATE_DIR="$BOXMUNGE_ROOT/upgrade-state"
ACTIVE_SLOT_FILE="$STATE_DIR/active-slot"
BLOCKLIST_FILE="$STATE_DIR/blocklist.json"
PROBATION_FILE="$STATE_DIR/probation.json"
# Root-only (BOXMUNGE_ROOT is root:root 0755); see acquire_lock and
# failure_count in state.sh.
UPGRADE_ROOT_DIR="$BOXMUNGE_ROOT/upgrade-root"
LOCK_FILE="$UPGRADE_ROOT_DIR/upgrade.lock"
LEGACY_LOCK_FILE="$STATE_DIR/upgrade.lock"
INTERRUPTED_FILE="$UPGRADE_ROOT_DIR/interrupted.json"
PIP_FAILURES_FILE="$UPGRADE_ROOT_DIR/pip-failures.json"
# The last release whose bundle has no requirements-mcp.txt. Every install
# needs it, so this shim cannot install that release or any before it.
LAST_RELEASE_WITHOUT_MCP_LOCK="0.10.1"
PROBATION_HOURS=6
BIN_DIR="$BOXMUNGE_ROOT/bin"
VERSION_FILE="$BOXMUNGE_ROOT/config/version"
SUDOERS_FILE="${BOXMUNGE_SUDOERS_FILE:-/etc/sudoers.d/boxmunge-deploy}"

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) boxmunge-upgrade: $*" >&2; }
die() { log "FATAL: $*"; exit 1; }

[[ "$BOXMUNGE_ROOT" == /* ]] || die "BOXMUNGE_ROOT must be an absolute path, not '$BOXMUNGE_ROOT'"

# bm_log <level> <component> <msg> [<detail-json>]
#
# Best-effort write to /opt/boxmunge/logs/boxmunge.log via the active venv's
# Python (so `boxmunge log` surfaces shim phase events alongside everything
# else). The shim is the operator's only recovery surface — a logging
# failure must not crash the upgrade — so the body is wrapped in
# `2>/dev/null || true`.
#
# Levels: info | warn | error. Detail JSON defaults to {}.
bm_log() {
    local level="$1" component="$2" msg="$3" detail="${4:-"{}"}"
    BM_LEVEL="$level" BM_COMPONENT="$component" BM_MSG="$msg" BM_DETAIL="$detail" \
        "$(active_venv)/bin/python" - <<'PYBM' 2>/dev/null || true
import json, os
from boxmunge.paths import BoxPaths
from boxmunge.log import log_operation, log_warning, log_error
fns = {"info": log_operation, "warn": log_warning, "error": log_error}
fn = fns.get(os.environ["BM_LEVEL"], log_operation)
try:
    detail = json.loads(os.environ["BM_DETAIL"])
except Exception:
    detail = {"raw": os.environ.get("BM_DETAIL", "")}
fn(os.environ["BM_COMPONENT"], os.environ["BM_MSG"], BoxPaths(), detail=detail)
PYBM
}

# >>> inlined from boxmunge-upgrade.d/state.sh by scripts/build-shim.py
# state.sh — validation of everything the shim reads, the active slot, the
# lock, the blocklist, per-version failure counts, and the upgrade policy.
# Part of boxmunge-upgrade (runs as root); scripts/build-shim.py inlines it into
# the shim that releases ship.

# ---------------------------------------------------------------------------
# Deploy-writable state.
#
# upgrade-state/ is root:deploy 0770 so the deploy shell can end probation
# early. Everything read from it is therefore untrusted input to this root
# process. Each value is checked against a strict allowlist before it can
# reach an executable path, a URL, or an rm -rf, and anything else stops the
# shim. Symlinks are refused, every read opens without following a link or
# blocking on a FIFO (read_untrusted), and writes go through rename(2), so a
# planted link is replaced rather than followed.
# ---------------------------------------------------------------------------
SEMVER_RE='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'
ACTIVE_SLOT=""
LOCK_HELD=0

printable() { local s="${1:0:80}"; printf '%s' "${s//[^[:alnum:]._+-]/?}"; }

require_slot() {  # require_slot <value> <where>
    [[ "$1" == "a" || "$1" == "b" ]] \
        || die "Invalid slot '$(printable "$1")' in $2 (expected a or b); refusing to continue"
}

require_semver() {  # require_semver <value> <where>
    [[ "$1" =~ $SEMVER_RE ]] \
        || die "Invalid version '$(printable "$1")' in $2 (expected semver like 0.3.5 or 0.3.5-rc.1)"
}

refuse_symlink() {
    [[ ! -L "$1" ]] || die "$1 is a symlink; refusing to use it as root. Remove it and re-run."
}

# read_untrusted <file>: print a deploy-writable file. A FIFO would block a
# plain read forever with upgrade.lock held, and a link swapped in after
# refuse_symlink would be read through, so the file is opened O_NOFOLLOW |
# O_NONBLOCK and anything but a regular file is refused. Use it as
# value="$(read_untrusted <file>)" || exit 1 (it has already said why).
read_untrusted() {
    local rc=0
    python3 - "$1" <<'PYRU' || rc=$?
import errno, os, stat, sys
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
except OSError as e:
    sys.exit(3 if e.errno == errno.ELOOP else f"{sys.argv[1]}: {e.strerror}")
with os.fdopen(fd, "rb") as f:
    if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
        sys.exit(3)
    sys.stdout.buffer.write(f.read())
PYRU
    case "$rc" in
        0) ;;
        3) die "$1 is a symlink, FIFO or other non-regular file; refusing to read it as root. Remove it and re-run." ;;
        *) die "Cannot read $1; inspect it and repair or remove it" ;;
    esac
}

# replace_file <src> <dest>: rename(2), which never follows a link at <dest>.
# (GNU mv would move <src> INTO <dest> if <dest> were a link to a directory.)
replace_file() {
    python3 -c 'import os, sys; os.replace(sys.argv[1], sys.argv[2])' "$1" "$2"
}

# load_active_slot: set ACTIVE_SLOT from the root-owned env-active symlink and
# the deploy-writable active-slot file. Both must name a or b, and they must
# agree: a forged active-slot would otherwise make the live venv look like
# the standby, and the next upgrade would rm -rf it. The one exception is a
# crash inside swap_to, proven by a root-owned upgrade-inflight or
# rollback-inflight marker in either slot (both are written before any swap):
# then root's env-active is the truth and active-slot is rewritten to match.
load_active_slot() {
    local from_file="" from_link="" target
    refuse_symlink "$ACTIVE_SLOT_FILE"
    if [[ -e "$ACTIVE_SLOT_FILE" ]]; then
        from_file="$(read_untrusted "$ACTIVE_SLOT_FILE")" || exit 1
        require_slot "$from_file" "$ACTIVE_SLOT_FILE"
    fi
    if [[ -L "$BOXMUNGE_ROOT/env-active" ]]; then
        target="$(readlink "$BOXMUNGE_ROOT/env-active")"
        case "$target" in
            "$BOXMUNGE_ROOT/env-a") from_link="a" ;;
            "$BOXMUNGE_ROOT/env-b") from_link="b" ;;
            *) die "env-active points at '$(printable "$target")', not env-a or env-b" ;;
        esac
    fi
    if [[ -n "$from_file" && -n "$from_link" && "$from_file" != "$from_link" ]]; then
        [[ -e "$(inflight_marker a)" || -e "$(inflight_marker b)" || -e "$(rollback_marker a)" || -e "$(rollback_marker b)" ]] \
            || die "active-slot says '$from_file' but env-active points at env-$from_link; refusing to guess which venv is live"
        log "WARN: active-slot disagrees with env-active after an interrupted swap; following env-active (slot $from_link)"
        write_active_slot_file "$from_link"
    fi
    ACTIVE_SLOT="${from_link:-$from_file}"
    [[ -n "$ACTIVE_SLOT" ]] || die "No active slot: neither $ACTIVE_SLOT_FILE nor $BOXMUNGE_ROOT/env-active exists"
}

standby_slot() { [[ "$ACTIVE_SLOT" == "a" ]] && echo "b" || echo "a"; }
active_venv() { echo "$BOXMUNGE_ROOT/env-$ACTIVE_SLOT"; }

# acquire_lock [skip]: take upgrade.lock once per run. With "skip", a busy
# lock exits 0 (the health timer retries on its next fire); otherwise it dies.
#
# upgrade.lock is in root-only upgrade-root/, so deploy cannot replace it to
# let a second upgrade run. Shims up to 0.10.1 lock upgrade-state/upgrade.lock
# (LEGACY_LOCK_FILE) instead: the one that installs this shim keeps running,
# holding only that, until its upgrade ends, and a 0.10.1 venv that upgrade
# rolls back to locks only that too. So this shim locks both, the root-only
# one first; the legacy lock matters only against those. It goes once no box
# can run a 0.10.1 shim or venv: when a release's pre-flight refuses to be
# installed over 0.10.1 or earlier.
#
# Deploy can plant anything at the legacy lock, and swap it between any check
# and the open. Every bash redirection follows a link, and the writing ones
# create a missing target, so bash never opens a lock: open_lock_and_reexec
# has Python open both without following a link or blocking on a FIFO, refuse
# anything but a plain regular file, put them on fds 9 and 8 and run this shim
# again with the same arguments. That run finds BM_UPGRADE_LOCK_FD=9 and
# checks fds 9 and 8 are the two lock files before it takes the flocks.
acquire_lock() {
    [[ "$LOCK_HELD" -eq 1 ]] && return 0
    if [[ "${BM_UPGRADE_LOCK_FD:-}" != 9 ]]; then
        refuse_symlink "$UPGRADE_ROOT_DIR"
        [[ -d "$UPGRADE_ROOT_DIR" ]] || mkdir -m 0700 "$UPGRADE_ROOT_DIR"
        mkdir -p "$STATE_DIR"
        refuse_symlink "$LOCK_FILE"
        refuse_symlink "$LEGACY_LOCK_FILE"
        open_lock_and_reexec
    fi
    unset BM_UPGRADE_LOCK_FD  # children inherit fds 9 and 8, never the claim that they are checked
    local why
    why="$(python3 -c 'import os, stat, sys
for fd, path in ((9, sys.argv[1]), (8, sys.argv[2])):
    try:
        held, name = os.fstat(fd), os.lstat(path)
    except OSError:
        sys.exit(f"fd {fd} is not {path}")
    if not (stat.S_ISREG(held.st_mode) and (held.st_dev, held.st_ino) == (name.st_dev, name.st_ino)):
        sys.exit(f"fd {fd} is not {path}")' "$LOCK_FILE" "$LEGACY_LOCK_FILE" 2>&1)" \
        || die "$why (it was replaced, or the descriptor came from elsewhere); refusing to lock it. Remove it and re-run."
    if ! flock -n 9 || ! flock -n 8; then
        [[ "${1:-}" == "skip" ]] && { log "Another upgrade is in progress; skipping"; exit 0; }
        die "Another upgrade is in progress"
    fi
    LOCK_HELD=1
}

# open_lock_and_reexec: see acquire_lock. Replaces this process; prints a
# FATAL line like die() when a lock file cannot be used.
open_lock_and_reexec() {
    exec python3 -c '
import errno, os, stat, sys, time
locks, shell, shim, args = sys.argv[1:3], sys.argv[3], sys.argv[4], sys.argv[5:]

def fatal(path, what):
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    sys.exit(f"{now} boxmunge-upgrade: FATAL: {path} {what}; refusing to use it as root. Remove it and re-run.")

for path, target in zip(locks, (9, 8)):
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    except OSError as e:
        fatal(path, "is a symlink" if e.errno == errno.ELOOP else f"cannot be opened ({e.strerror})")
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
        fatal(path, "is not a plain regular file")
    os.set_blocking(fd, True)
    if fd != target:
        os.dup2(fd, target)
        os.close(fd)
    os.set_inheritable(target, True)
os.environ["BM_UPGRADE_LOCK_FD"] = "9"
os.execv(shell, [shell, shim, *args])
' "$LOCK_FILE" "$LEGACY_LOCK_FILE" "$BASH" "$SHIM_PATH" "${SHIM_ARGS[@]+"${SHIM_ARGS[@]}"}"
}

# is_blocklisted <version>: 0 if listed, 1 if not. A blocklist that is not a
# JSON object keyed by semver strings is corrupt or tampered with: stop.
is_blocklisted() {
    local rc=0 content
    refuse_symlink "$BLOCKLIST_FILE"
    [[ -e "$BLOCKLIST_FILE" ]] || return 1
    content="$(read_untrusted "$BLOCKLIST_FILE")" || exit 1
    BM_VERSION="$1" BM_BLOCKLIST="$content" BM_SEMVER_RE="$SEMVER_RE" python3 - <<'PYBL' || rc=$?
import json, os, re, sys
try:
    bl = json.loads(os.environ["BM_BLOCKLIST"])
except ValueError as e:
    print(f"blocklist unreadable: {e}", file=sys.stderr)
    sys.exit(3)
pattern = re.compile(os.environ["BM_SEMVER_RE"])
if not isinstance(bl, dict) or not all(isinstance(k, str) and pattern.fullmatch(k) for k in bl):
    print("blocklist is not an object keyed by semver versions", file=sys.stderr)
    sys.exit(3)
sys.exit(0 if os.environ["BM_VERSION"] in bl else 1)
PYBL
    case "$rc" in
        0|1) return "$rc" ;;
        *) die "$BLOCKLIST_FILE is malformed; inspect it and repair or remove it" ;;
    esac
}

# write_active_slot_file <slot>: the temp file is written, chmod'd and synced
# through the descriptor that created it. upgrade-state/ is deploy-writable,
# so reopening the temp by name could follow a link deploy renamed over it.
write_active_slot_file() {
    BM_SLOT="$1" BM_FILE="$ACTIVE_SLOT_FILE" python3 - <<'PYAS'
import os, tempfile
path = os.environ["BM_FILE"]
directory = os.path.dirname(path)
fd, tmp = tempfile.mkstemp(dir=directory, prefix=".active-slot.")
try:
    with os.fdopen(fd, "w") as f:
        f.write(os.environ["BM_SLOT"] + "\n")
        f.flush()
        os.fchmod(f.fileno(), 0o644)
        os.fsync(f.fileno())
    os.replace(tmp, path)
except BaseException:
    if os.path.lexists(tmp):
        os.unlink(tmp)
    raise
dir_fd = os.open(directory, os.O_RDONLY)
os.fsync(dir_fd)
os.close(dir_fd)
PYAS
}

add_blocklist() {
    local version="$1" reason="$2"
    BM_VERSION="$version" BM_REASON="$reason" "$(active_venv)/bin/python" -c "
import os
from boxmunge.upgrade_state import add_to_blocklist
from boxmunge.paths import BoxPaths
add_to_blocklist(BoxPaths(), os.environ['BM_VERSION'], os.environ['BM_REASON'])
"
}

# Failures that are rarely the release's fault are counted per version, so
# the first one is retried and only a repeat blocklists:
#   interruptions <version> [<count>]  the upgrade was interrupted after its
#                                      venv swap (a power cut, a kill)
#   pip_failures <version> [<count>]   its hash-pinned dependencies failed to
#                                      install (a network blip, a full disk)
# Each prints the count, or sets it (0 forgets it).
interruptions() { failure_count "$INTERRUPTED_FILE" "$@"; }
pip_failures() { failure_count "$PIP_FAILURES_FILE" "$@"; }

# failure_count <file> <version> [<count>]: the counts behind the above. Kept
# in a root-only directory, not deploy-writable upgrade-state/, so deploy
# cannot wedge recovery with a malformed file. Written by fsync + rename +
# directory fsync.
failure_count() {
    local file="$1"
    shift
    refuse_symlink "$UPGRADE_ROOT_DIR"
    refuse_symlink "$file"
    [[ $# -eq 1 || -d "$UPGRADE_ROOT_DIR" ]] || mkdir -m 0700 "$UPGRADE_ROOT_DIR"
    BM_VERSION="$1" BM_COUNT="${2:-}" BM_FILE="$file" BM_SEMVER_RE="$SEMVER_RE" python3 - <<'PYINT' \
        || die "$file is malformed; inspect it and repair or remove it"
import json, os, re, sys, tempfile
path, version, count = os.environ["BM_FILE"], os.environ["BM_VERSION"], os.environ["BM_COUNT"]
counts = {}
if os.path.exists(path):
    with open(path) as f:
        counts = json.load(f)
pattern = re.compile(os.environ["BM_SEMVER_RE"])
if not isinstance(counts, dict) or not all(
        isinstance(k, str) and pattern.fullmatch(k) and type(v) is int for k, v in counts.items()):
    sys.exit(f"{os.path.basename(path)} is not an object of semver version -> count")
if not count:
    print(counts.get(version, 0))
    sys.exit(0)
counts.pop(version, None)
if int(count):
    counts[version] = int(count)
directory = os.path.dirname(path)
fd, tmp = tempfile.mkstemp(dir=directory, prefix=f".{os.path.basename(path)}.")
with os.fdopen(fd, "w") as f:
    json.dump(counts, f)
    f.flush()
    os.fsync(f.fileno())
os.replace(tmp, path)
dir_fd = os.open(directory, os.O_RDONLY)
os.fsync(dir_fd)
os.close(dir_fd)
PYINT
}

# ---------------------------------------------------------------------------
# Upgrade policy: what each entry point may install.
# ---------------------------------------------------------------------------

# semver_lt <a> <b>: true when <a> has lower semver precedence than <b>.
semver_lt() {
    BM_A="$1" BM_B="$2" python3 - <<'PYSV'
import os, sys
def key(v):
    core, _, pre = v.partition("-")
    nums = tuple(int(x) for x in core.split("."))
    if not pre:
        return nums, 1, ()
    return nums, 0, tuple((0, int(p), "") if p.isdigit() else (1, 0, p) for p in pre.split("."))
sys.exit(0 if key(os.environ["BM_A"]) < key(os.environ["BM_B"]) else 1)
PYSV
}

# installed_version: the semver recorded in config/version (root-owned; the
# config dir is not deploy-writable).
installed_version() {
    local v
    [[ -f "$VERSION_FILE" ]] || die "No installed version recorded at $VERSION_FILE"
    v="$(cat "$VERSION_FILE")"
    v="${v%%+*}"
    require_semver "$v" "$VERSION_FILE"
    echo "$v"
}

# check_policy <version> <mode>: mode is run (timer), target (deploy) or
# force (operator). Only force may install a blocklisted or older version,
# and no mode a release from before the hash-pinned MCP requirements. That
# refusal is about this shim, not the release, so it is never blocklisted.
check_policy() {
    local version="$1" mode="$2" installed operator_hint
    require_semver "$version" "requested version"
    if ! semver_lt "$LAST_RELEASE_WITHOUT_MCP_LOCK" "$version"; then
        die "Bundle $version predates the hash-pinned requirements-mcp.txt every install needs; force-target cannot go below the first release after $LAST_RELEASE_WITHOUT_MCP_LOCK"
    fi
    operator_hint="To override, run as supervisor: sudo $BIN_DIR/boxmunge-upgrade force-target $version"
    if [[ "$mode" == "force" ]]; then
        log "WARN: operator override: blocklist and downgrade floor not enforced for $version"
        return 0
    fi
    if is_blocklisted "$version"; then
        if [[ "$mode" == "run" ]]; then
            log "Version $version is blocklisted, skipping"
            exit 0
        fi
        die "Version $version is blocklisted on this box (it failed an earlier upgrade). $operator_hint"
    fi
    installed="$(installed_version)"
    if semver_lt "$version" "$installed"; then
        die "Refusing to downgrade from $installed to $version. $operator_hint"
    fi
}
# <<< boxmunge-upgrade.d/state.sh

# >>> inlined from boxmunge-upgrade.d/slots.sh by scripts/build-shim.py
# slots.sh — the two venv slots: whether a slot can be trusted, the
# crash-safety markers, the swap, and rollback.
# Part of boxmunge-upgrade (runs as root); scripts/build-shim.py inlines it into
# the shim that releases ship.

# ---------------------------------------------------------------------------
# Crash-safety markers. Both live inside a venv slot, which is root-owned, so
# deploy cannot forge them, and each is synced to disk before the swap it
# guards.
#
#   upgrade-inflight   "<version>"
#       In the slot an upgrade installs, from just before the swap until
#       probation is recorded. While it is in the live slot, the standby is
#       the proven release and must not be deleted.
#   rollback-inflight  "<version>\n<stage>\n<interruption count>"
#       In the slot a rollback returns to, from just before its swap until the
#       rollback has finished. check-probation finishes a rollback cut short.
#
# CROSS-VERSION CONTRACT: a box can crash under this shim and come back under
# a later one (the next upgrade self-updates the shim before its swap, and
# install.sh may be re-run). Every later shim must honour both markers as
# described in resume_rollback and recover_interrupted_upgrade (probation.sh),
# or migrate them, and must never delete a slot that holds one, or the slot a
# marker says is the rollback target, without resolving it first.
# ---------------------------------------------------------------------------
inflight_marker() { echo "$BOXMUNGE_ROOT/env-$1/upgrade-inflight"; }
rollback_marker() { echo "$BOXMUNGE_ROOT/env-$1/rollback-inflight"; }

# slot_works <slot>: the slot's boxmunge-server runs. Checked before a slot is
# trusted to take over, and before another slot is deleted on its strength.
slot_works() {
    local server="$BOXMUNGE_ROOT/env-$1/bin/boxmunge-server"
    [[ -x "$server" ]] && "$server" --version >/dev/null 2>&1
}

# rollback_target_ok <slot>: a working venv that is not a half-finished upgrade.
rollback_target_ok() { slot_works "$1" && [[ ! -e "$(inflight_marker "$1")" ]]; }

# remove_slot <slot>: the only way the shim deletes a venv slot. Never the one
# env-active points at, and never while the live slot does not work: then
# <slot> may be all that is left to run the platform.
remove_slot() {
    local slot="$1"
    require_slot "$slot" "slot removal"
    [[ "$slot" != "$ACTIVE_SLOT" && "$(readlink "$BOXMUNGE_ROOT/env-active" 2>/dev/null)" != "$BOXMUNGE_ROOT/env-$slot" ]] \
        || die "Refusing to remove env-$slot: it is the live slot"
    slot_works "$ACTIVE_SLOT" \
        || die "Refusing to remove env-$slot: the live slot env-$ACTIVE_SLOT is not a working venv; inspect both as supervisor"
    rm -rf "${BOXMUNGE_ROOT:?}/env-$slot"
}

swap_to() {
    local slot="$1"
    require_slot "$slot" "swap target"
    slot_works "$slot" || die "Refusing to swap to env-$slot: it is not a working venv"
    ln -sfn "$BOXMUNGE_ROOT/env-$slot" "$BOXMUNGE_ROOT/env-active"
    write_active_slot_file "$slot"
    ACTIVE_SLOT="$slot"
    # Durable before anything runs on the new slot: an apply that migrated
    # state must never come back after a crash under the other slot's code.
    sync
    # The user-facing /opt/boxmunge/bin/boxmunge-server wrapper already routes
    # through env-active/bin/boxmunge-server, so the symlink swap above
    # is sufficient — no need to touch the wrapper itself.
    log "Swapped active to slot $slot"
}

report_failure() {
    local version="$1" from_version="$2" stage="$3"
    BM_VERSION="$version" BM_FROM_VERSION="$from_version" BM_STAGE="$stage" "$(active_venv)/bin/python" -c "
import os
from boxmunge.report_failure import report_failure
report_failure(os.environ['BM_VERSION'], os.environ['BM_FROM_VERSION'], os.environ['BM_STAGE'])
" 2>/dev/null || true
}

send_notification() {
    local title="$1" message="$2" priority="${3:-0}"
    BM_TITLE="$title" BM_MESSAGE="$message" BM_PRIORITY="$priority" "$(active_venv)/bin/python" -c "
import os
from boxmunge.config import load_config
from boxmunge.pushover import send_notification
from boxmunge.paths import BoxPaths
config = load_config(BoxPaths())
po = config.get('pushover', {})
send_notification(po.get('user_key',''), po.get('app_token',''), os.environ['BM_TITLE'], os.environ['BM_MESSAGE'],
                  int(os.environ['BM_PRIORITY']))
" 2>/dev/null || true
}

# rollback_partial <new_version> <from_version> <stage> <prev_slot> <step> <exit> <output>
#
# The venv is back on the previous slot but disk state may be partly
# upgraded, a hybrid the old code is not guaranteed to handle. Hard failure
# demanding operator attention; exit 2 so monitoring can tell it from a
# clean rollback (exit 1). The rollback marker goes too: retrying on every
# health tick would only repeat the alert, and the operator now owns this.
rollback_partial() {
    local new_version="$1" from_version="$2" stage="$3" prev_slot="$4" step="$5" rc="$6" output="$7"
    log "ERROR: $step failed during rollback (exit $rc)"
    log "ERROR: $step output: $output"
    bm_log error upgrade "rollback partial — manual intervention required" \
        "{\"version\": \"$new_version\", \"stage\": \"$stage\", \"step\": \"$step\", \"exit\": $rc}"
    add_blocklist "$new_version" "${stage}_partial_rollback"
    [[ "$stage" == interrupted ]] || report_failure "$new_version" "$from_version" "apply_partial_rollback"
    # Truncate output in the alert body — Pushover messages are length-limited.
    send_notification "boxmunge ROLLBACK PARTIAL" \
        "ROLLBACK PARTIAL — manual intervention required.
Version: $new_version
Stage: $stage
Failed step: $step (exit $rc)
Output (truncated): ${output:0:500}"
    rm -f "$(rollback_marker "$prev_slot")"
    log "Rollback PARTIAL: venv reverted to slot $prev_slot but $step failed"
    exit 2
}

# do_rollback <new_version> <from_version> <stage> <prev_slot>: return to
# <prev_slot>. The rollback-inflight marker is on disk before the swap, so a
# crash anywhere from here on is finished by the next check-probation.
#
# An interruption (stage "interrupted": a power cut or kill) is rarely the
# release's fault. The first one of a version is not blocklisted, so
# auto-update retries it; a second one is, so a release whose apply reliably
# hangs or is killed cannot loop. The count is decided here, kept in the
# marker, and recorded only once the rollback has succeeded.
do_rollback() {
    local new_version="$1" from_version="$2" stage="$3" prev_slot="$4" count=0
    rollback_target_ok "$prev_slot" \
        || die "Cannot roll back $new_version: env-$prev_slot is not a working venv, or is itself a half-finished upgrade; inspect it as supervisor"
    [[ "$stage" != interrupted ]] || count=$(( $(interruptions "$new_version") + 1 ))
    printf '%s\n%s\n%s\n' "$new_version" "$stage" "$count" > "$(rollback_marker "$prev_slot")"
    sync
    complete_rollback "$new_version" "$from_version" "$stage" "$prev_slot" "$count"
}

# legacy_caddy_log_note <version>: what the active (previous) release costs CrowdSec. A
# release from before Caddy logged to stdout writes Caddy's access log to a
# tmpfs inside the container that nothing reads (caddy/compose.yml), so
# HTTP-layer detection is off until the next upgrade. Read from that
# release's own root-owned code, never from the deploy-writable site files.
legacy_caddy_log_note() {
    if grep -qsF "output file /var/log/caddy/access.log" \
            "$(active_venv)"/lib/python3*/site-packages/boxmunge/caddy.py; then
        echo " HTTP-layer detection is off until the next upgrade: $1 writes Caddy's access log to a file CrowdSec does not read."
    fi
}

# teardown_before_rollback: staging-teardown-all with the active (new)
# release. It alerts per project itself and exits 0 even when a project
# fails; a non-zero exit means it did not finish (killed by the timeout,
# crashed, or could not start), so which projects still hold a slot is
# unknown and the alert here names the generic manual commands. It never
# blocks the rollback. The 600 s budget covers one compose down per staged
# project; a box with many slack staging stacks may need longer, and then
# keeps the rest (harmless to the older release) with this alert.
teardown_before_rollback() {
    local rc=0
    timeout --kill-after=10 600 "$(active_venv)/bin/boxmunge-server" staging-teardown-all \
        --reason platform-rollback || rc=$?
    [[ "$rc" -ne 0 ]] || return 0
    local msg="staging teardown before the rollback did not finish (exit $rc); staged releases may remain under <p>/.releases/staged/; the older release ignores them; remove each with: docker compose -p <p>-staging --project-directory <p>/.releases/staged/release -f <p>/.releases/staged/compose.staging-base.yml -f <p>/.releases/staged/compose.boxmunge-staging.yml down, then rm -rf <p>/.releases/staged and rm caddy/sites/<p>-staging.conf"
    log "WARN: $msg"
    bm_log warn upgrade "staging teardown before the rollback did not finish" "{\"exit\": $rc}"
    send_notification "boxmunge rollback: staged releases not torn down" "$msg" 1
}

# complete_rollback <new_version> <from_version> <stage> <prev_slot> <count>:
# everything after the marker. Safe to run again after a crash part-way: the
# swap is skipped once done, the stash restore and re-apply are idempotent,
# and the interruption count is set, not incremented.
complete_rollback() {
    local new_version="$1" from_version="$2" stage="$3" prev_slot="$4" count="$5"
    log "ROLLBACK: $new_version failed at stage=$stage, reverting to slot $prev_slot"
    bm_log warn upgrade "rollback initiated" "{\"version\": \"$new_version\", \"from_version\": \"$from_version\", \"stage\": \"$stage\"}"

    # D14: the release being rolled back from tears down its staged releases
    # (an older release does not know .releases/staged/). Only before the
    # swap: once swapped, the active venv is the older release.
    if [[ "$ACTIVE_SLOT" != "$prev_slot" ]]; then
        teardown_before_rollback
    fi
    [[ "$ACTIVE_SLOT" == "$prev_slot" ]] || swap_to "$prev_slot"
    # Any probation ended with this rollback. Left behind, it would name the
    # now-live slot as previous_slot.
    rm -f "$PROBATION_FILE"

    # 1. Stash restore returns config + state to the pre-upgrade snapshot.
    local output rc=0
    output="$("$(active_venv)/bin/boxmunge-server" stash restore --latest 2>&1)" || rc=$?
    [[ "$rc" -eq 0 ]] || rollback_partial "$new_version" "$from_version" "$stage" "$prev_slot" \
        "stash restore" "$rc" "$output"

    # 2. Re-apply with the previous release's code. The stash holds inputs
    #    (manifests, compose, secrets), not generated output: the overlays and
    #    Caddy sites on disk, and the running containers, are still the new
    #    release's. --apply regenerates both with the old code, reloads Caddy
    #    and restarts projects, so a generator regression is really undone.
    rc=0
    output="$("$(active_venv)/bin/boxmunge-server" upgrade --apply 2>&1)" || rc=$?
    [[ "$rc" -eq 0 ]] || rollback_partial "$new_version" "$from_version" "$stage" "$prev_slot" \
        "re-apply of the previous release" "$rc" "$output"

    refresh_docs_for_slot "$prev_slot"
    local note
    note="$(legacy_caddy_log_note "$from_version")"
    if [[ -n "$note" ]]; then
        log "WARNING:$note"
        bm_log warn upgrade "HTTP-layer detection off after rollback" "{\"version\": \"$from_version\"}"
    fi
    # The box is back on the previous release. Drop the marker before any
    # bookkeeping, the interruption count included: if that fails (a corrupt
    # interrupted.json, say), the next fire must not restore and re-apply
    # (restarting every project) all over again. A crash right here loses
    # one interruption from the count: at worst one extra retry.
    rm -f "$(rollback_marker "$prev_slot")"
    [[ "$stage" != interrupted ]] || interruptions "$new_version" "$count"
    if [[ "$stage" == interrupted ]]; then
        # Not reported to the fleet service: a power cut must not count
        # toward suppressing a release. The operator still hears of it.
        local outcome="not blocklisted; auto-update will retry it"
        if [[ "$count" -ge 2 ]]; then
            add_blocklist "$new_version" "$stage"
            outcome="interrupted $count times, now blocklisted"
        fi
        bm_log warn upgrade "interrupted upgrade rolled back" "{\"version\": \"$new_version\", \"interruptions\": $count}"
        send_notification "boxmunge ROLLBACK" "Rolled back $new_version: the upgrade was interrupted ($outcome).$note"
    else
        add_blocklist "$new_version" "$stage"
        report_failure "$new_version" "$from_version" "$stage"
        send_notification "boxmunge ROLLBACK" "Rolled back $new_version (stage: $stage).$note"
    fi

    log "Rollback complete: reverted to $from_version"
    exit 1
}
# <<< boxmunge-upgrade.d/slots.sh

# >>> inlined from boxmunge-upgrade.d/probation.sh by scripts/build-shim.py
# probation.sh — reading probation.json, deferring upgrades while a release
# is unproven, and check-probation: finishing interrupted rollbacks and
# upgrades, promotion, and rollback.
# Part of boxmunge-upgrade (runs as root); scripts/build-shim.py inlines it into
# the shim that releases ship.

# read_probation: parse probation.json into PROB_VERSION, PROB_PREV_SLOT,
# PROB_EXPIRED (yes/no) and PROB_EXPIRES_AT (re-formatted in UTC, so safe to
# print). The file is deploy-writable, so an expires_at beyond a fresh
# probation's length (plus slack for clock steps) is forged or corrupt: it
# counts as expired, or a far-future value would defer upgrades for good.
read_probation() {
    local out content
    refuse_symlink "$PROBATION_FILE"
    content="$(read_untrusted "$PROBATION_FILE")" || exit 1
    out="$(BM_PROBATION="$content" BM_HOURS="$PROBATION_HOURS" python3 - <<'PYPROB'
import json, os, sys
from datetime import datetime, timedelta, timezone
d = json.loads(os.environ["BM_PROBATION"])
keys = ("version", "previous_slot", "expires_at")
if not isinstance(d, dict) or not all(isinstance(d.get(k), str) and "\n" not in d[k] for k in keys):
    sys.exit("probation.json must hold string version, previous_slot and expires_at")
expires = datetime.fromisoformat(d["expires_at"])
if expires.tzinfo is None:
    sys.exit("probation.json expires_at has no timezone")
now = datetime.now(timezone.utc)
beyond_cap = expires > now + timedelta(hours=int(os.environ["BM_HOURS"]), minutes=15)
print(d["version"])
print(d["previous_slot"])
print("yes" if now >= expires or beyond_cap else "no")
print(expires.astimezone(timezone.utc).strftime("%Y-%m-%d %H:%M UTC"))
print("beyond_cap" if beyond_cap else "")
PYPROB
)" || die "$PROBATION_FILE is malformed; refusing to act on it"
    PROB_VERSION="$(echo "$out" | sed -n '1p')"
    PROB_PREV_SLOT="$(echo "$out" | sed -n '2p')"
    PROB_EXPIRED="$(echo "$out" | sed -n '3p')"
    PROB_EXPIRES_AT="$(echo "$out" | sed -n '4p')"
    require_semver "$PROB_VERSION" "$PROBATION_FILE"
    require_slot "$PROB_PREV_SLOT" "$PROBATION_FILE"
    if [[ "$(echo "$out" | sed -n '5p')" == beyond_cap ]]; then
        log "WARN: $PROBATION_FILE expires_at $PROB_EXPIRES_AT is beyond a ${PROBATION_HOURS}h probation; treating it as expired"
        bm_log warn upgrade "probation expiry beyond cap" "{\"version\": \"$PROB_VERSION\"}"
    fi
}

# load_probation: 0 with PROB_* set while a release is on probation, 1 when
# there is none. A probation naming the live slot as previous_slot is stale
# (an older shim's rollback left it behind; deploy may remove it anyway), so
# it is removed with a warning. Otherwise previous_slot must be a slot a
# rollback could really use; promotion deletes it.
load_probation() {
    [[ -e "$PROBATION_FILE" || -L "$PROBATION_FILE" ]] || return 1
    read_probation
    if [[ "$PROB_PREV_SLOT" == "$ACTIVE_SLOT" ]]; then
        [[ ! -e "$(inflight_marker "$ACTIVE_SLOT")" ]] \
            || die "$PROBATION_FILE names the live slot during an interrupted upgrade; refusing to act on it"
        log "WARN: removing stale $PROBATION_FILE: previous_slot '$PROB_PREV_SLOT' is the live slot"
        bm_log warn upgrade "stale probation removed" "{\"version\": \"$PROB_VERSION\"}"
        rm -f "$PROBATION_FILE"
        return 1
    fi
    rollback_target_ok "$PROB_PREV_SLOT" \
        || die "$PROBATION_FILE previous_slot '$PROB_PREV_SLOT' is not a working venv a rollback could use; inspect it as supervisor, or remove the file to accept $PROB_VERSION"
}

# refuse_during_probation <version> <mode>: while a release is on probation,
# the standby slot holds the last proven release and is the only rollback
# target. Building another release there would leave nothing proven to fall
# back to, so every entry point, force-target included, waits until
# check-probation promotes or rolls back; likewise while it has an interrupted
# upgrade or rollback to finish. This is a deferral, not a failure of
# <version>: no blocklist entry and no failure report. The timer (run) exits
# 0 like a blocklisted version, and retries on its next run.
refuse_during_probation() {
    local version="$1" mode="$2" why retry
    if [[ -e "$(inflight_marker "$ACTIVE_SLOT")" || -e "$(rollback_marker a)" || -e "$(rollback_marker b)" ]]; then
        why="an earlier upgrade or rollback was interrupted, and the health timer's check-probation finishes it within minutes"
        retry="Retry after that."
    elif load_probation; then
        why="$PROB_VERSION is on probation (it ends $PROB_EXPIRES_AT)"
        [[ "$PROB_EXPIRED" == "no" ]] || why="$PROB_VERSION is on probation (it has expired and the health timer promotes it within minutes)"
        why="$why and slot $PROB_PREV_SLOT holds the previous release, the only rollback target"
        retry="Retry after the probation ends."
        [[ "$mode" != "force" ]] || retry="To accept $PROB_VERSION and give up that fallback now, remove $PROBATION_FILE and re-run."
    else
        return 0
    fi
    bm_log warn upgrade "upgrade deferred: probation active" "{\"version\": \"$version\", \"mode\": \"$mode\"}"
    if [[ "$mode" == "run" ]]; then
        log "Not upgrading to $version: $why. Deferred; auto-update retries on its next run."
        exit 0
    fi
    die "Not upgrading to $version: $why. $retry"
}

# resume_rollback: a rollback-inflight marker means a rollback was cut short.
# Finish it onto the slot holding the marker: the swap if it never happened,
# then the stash restore and re-apply again, then the bookkeeping.
resume_rollback() {
    local slot marker version="" stage="" count=""
    for slot in "$ACTIVE_SLOT" "$(standby_slot)"; do
        marker="$(rollback_marker "$slot")"
        [[ -e "$marker" ]] || continue
        { read -r version; read -r stage; read -r count; } < "$marker" || true
        require_semver "$version" "$marker"
        [[ "$stage" =~ ^[a-z_]+$ && "$count" =~ ^[0-9]+$ ]] \
            || die "$marker is malformed; inspect both slots as supervisor"
        rollback_target_ok "$slot" \
            || die "$marker is in env-$slot, which is not a working venv; inspect both slots as supervisor"
        log "Resuming the interrupted rollback of $version (stage $stage) onto slot $slot"
        complete_rollback "$version" "$("$BOXMUNGE_ROOT/env-$slot/bin/boxmunge-server" --version 2>/dev/null || echo "unknown")" \
            "$stage" "$slot" "$count"
    done
}

# recover_interrupted_upgrade: the live slot still carries upgrade-inflight,
# so the shim died after the swap and before probation was recorded (unless
# it died just after recording it). Apply may not have finished, so roll back
# to the standby, the proven release. A marker left in the standby means the
# swap never happened; the orphan cleanup that follows removes that slot.
recover_interrupted_upgrade() {
    local marker version
    marker="$(inflight_marker "$ACTIVE_SLOT")"
    [[ -e "$marker" ]] || return 0
    version="$(cat "$marker")"
    require_semver "$version" "$marker"
    if load_probation && [[ "$PROB_VERSION" == "$version" ]]; then
        rm -f "$marker"
        return 0
    fi
    log "Upgrade to $version was interrupted after the venv swap — rolling back"
    do_rollback "$version" "$("$BOXMUNGE_ROOT/env-$(standby_slot)/bin/boxmunge-server" --version 2>/dev/null || echo "unknown")" \
        interrupted "$(standby_slot)"
}

cmd_check_probation() {
    load_active_slot
    acquire_lock skip  # an upgrade is in progress; retry on the next health-timer fire
    resume_rollback
    recover_interrupted_upgrade

    local inactive
    inactive="$(standby_slot)"
    if ! load_probation; then
        # No probation, so a standby venv is an orphan: left by a rollback, an
        # upgrade that failed before its swap, or a promotion made from the
        # deploy context (deploy cannot rmtree root-owned dirs).
        if [[ -d "$BOXMUNGE_ROOT/env-$inactive" ]]; then
            log "Cleaning up orphan venv in inactive slot $inactive"
            remove_slot "$inactive"
        fi
        exit 0
    fi
    local version="$PROB_VERSION" prev_slot="$PROB_PREV_SLOT"

    if [[ "$PROB_EXPIRED" == "yes" ]]; then
        log "Probation expired for $version — promoting"
        remove_slot "$prev_slot"
        rm -f "$PROBATION_FILE"
        interruptions "$version" 0
        log "Version $version promoted"
        bm_log info upgrade "probation passed" "{\"version\": \"$version\"}"
        exit 0
    fi

    # Probation health check semantics:
    #   exit 2     -> CRITICAL: real health regression -> rollback
    #   exit 124+  -> OPERATIONAL: timed out / killed (e.g. multiple sequential
    #                 docker subprocess timeouts on a busy host can exceed our
    #                 budget without any platform regression). Skip rollback;
    #                 the next health-timer fire will retry.
    #   else        -> healthy (or warnings only) -> continue probation
    # --kill-after=10 escalates SIGTERM -> SIGKILL if the health subprocess
    # ignores the initial SIGTERM (e.g. wedged docker socket). Without it,
    # `timeout 180` waits indefinitely for an unresponsive process and
    # successive timer fires stack stuck health invocations.
    local health_exit=0
    timeout --kill-after=10 180 "$(active_venv)/bin/boxmunge-server" health --json >/dev/null 2>&1 || health_exit=$?

    if [[ "$health_exit" -eq 2 ]]; then
        local from_version
        from_version="$("$BOXMUNGE_ROOT/env-$prev_slot/bin/boxmunge-server" --version 2>/dev/null || echo "unknown")"
        log "CRITICAL health failure during probation for $version — rolling back"
        do_rollback "$version" "$from_version" "health_probation" "$prev_slot"
    elif [[ "$health_exit" -ge 124 ]]; then
        log "WARN: probation health check timed out (exit $health_exit) for $version — skipping rollback, next health-timer will retry"
    fi

    exit 0
}
# <<< boxmunge-upgrade.d/probation.sh

# >>> inlined from boxmunge-upgrade.d/system.sh by scripts/build-shim.py
# system.sh — release signature check, deploy's sudo rule, on-box docs, and
# the shim's own self-update.
# Part of boxmunge-upgrade (runs as root); scripts/build-shim.py inlines it into
# the shim that releases ship.

# Cosign verification pins. The release workflow keyless-signs SHA256SUMS via
# Sigstore's Fulcio + Rekor. We pin the OIDC issuer and the workflow identity
# so a signature from any other workflow (or any other repo) is rejected.
COSIGN_CERT_IDENTITY_REGEXP='^https://github\.com/boxmunge/boxmunge/\.github/workflows/release\.yml@refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$'
COSIGN_OIDC_ISSUER='https://token.actions.githubusercontent.com'

# verify_release_signature <download_dir>
#
# Verifies $download_dir/SHA256SUMS against $download_dir/SHA256SUMS.sig with
# certificate $download_dir/SHA256SUMS.cert, pinning the certificate identity
# to this repo's release workflow on a vX.Y.Z tag.
#
# Hard-requires cosign on PATH; aborts noisily if missing. Returns 0 on success
# and non-zero on any failure (cosign missing, signature/cert files missing,
# verification failed).
verify_release_signature() {
    local download_dir="${1:?usage: verify_release_signature <download_dir>}"
    if ! command -v cosign >/dev/null 2>&1; then
        log "ERROR: cosign required for upgrade verification but not installed."
        log "       Re-run install.sh on this host, or install cosign manually."
        return 1
    fi
    local sums="$download_dir/SHA256SUMS"
    local sig="$download_dir/SHA256SUMS.sig"
    local cert="$download_dir/SHA256SUMS.cert"
    if [[ ! -f "$sig" || ! -f "$cert" ]]; then
        log "ERROR: cosign signature/certificate not found in release artifacts"
        log "       missing: $([[ -f "$sig" ]] || echo "SHA256SUMS.sig") $([[ -f "$cert" ]] || echo "SHA256SUMS.cert")"
        return 1
    fi
    cosign verify-blob \
        --certificate-identity-regexp "$COSIGN_CERT_IDENTITY_REGEXP" \
        --certificate-oidc-issuer "$COSIGN_OIDC_ISSUER" \
        --signature "$sig" \
        --certificate "$cert" \
        "$sums" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# deploy's sudo rule. Owned here so install.sh and every upgrade write the
# same text; a box whose rule predates a tightening is fixed on its next
# upgrade. `target *` cannot reach force-target or any other subcommand:
# sudo matches the whole argument string against the pattern.
# ---------------------------------------------------------------------------
sudoers_rule() {
    cat <<EOF
# Managed by boxmunge-upgrade install-sudoers; rewritten on every install and upgrade.
deploy ALL=(root) NOPASSWD: $BIN_DIR/boxmunge-upgrade auto, $BIN_DIR/boxmunge-upgrade target *
EOF
}

cmd_install_sudoers() {
    local tmp
    if [[ -f "$SUDOERS_FILE" && ! -L "$SUDOERS_FILE" ]] && cmp -s <(sudoers_rule) "$SUDOERS_FILE"; then
        return 0
    fi
    # A dot in the name keeps sudo from reading the temp file mid-write.
    tmp="$(mktemp "$(dirname "$SUDOERS_FILE")/.boxmunge-deploy.XXXXXX")"
    sudoers_rule > "$tmp"
    chmod 0440 "$tmp"
    if ! visudo -cqf "$tmp" >/dev/null; then
        rm -f "$tmp"
        die "Generated sudoers rule failed visudo; $SUDOERS_FILE left unchanged"
    fi
    replace_file "$tmp" "$SUDOERS_FILE"
    log "Wrote deploy sudo rule to $SUDOERS_FILE"
}

# ---------------------------------------------------------------------------
# On-box docs (served by agent-help). Each venv slot keeps the docs of the
# release it holds in env-<slot>/boxmunge-docs, so a rollback can put the
# matching docs back. docs/ is a symlink to a versioned sibling directory and
# is swapped by rename: a reader sees the old set or the new set, never a
# partial or empty one. Doc files missing from the new set disappear.
# ---------------------------------------------------------------------------
slot_docs() { echo "$BOXMUNGE_ROOT/env-$1/boxmunge-docs"; }

# install_docs <dir>: returns non-zero (and changes nothing) if <dir> has no
# *.md files.
install_docs() {
    local src="$1" docs="$BOXMUNGE_ROOT/docs" stage link previous old=""
    if ! compgen -G "$src/*.md" >/dev/null; then
        log "ERROR: no *.md docs in $src; $docs left unchanged"
        return 1
    fi
    stage="$(mktemp -d "$BOXMUNGE_ROOT/.docs.XXXXXX")"
    cp "$src"/*.md "$stage/"
    chmod 0644 "$stage"/*.md
    chmod 0755 "$stage"
    if [[ "$(id -u)" -eq 0 ]]; then chown -R root:root "$stage"; fi
    link="$stage.link"
    ln -s "$(basename "$stage")" "$link"
    previous="$(readlink "$docs" 2>/dev/null || true)"
    if [[ -d "$docs" && ! -L "$docs" ]]; then
        # One-time move from a plain directory (installs before this change).
        old="$stage.old"
        mv "$docs" "$old"
    fi
    replace_file "$link" "$docs"
    [[ -z "$old" ]] || rm -rf "$old"
    if [[ "$previous" =~ ^\.docs\.[A-Za-z0-9]+$ ]]; then rm -rf "${BOXMUNGE_ROOT:?}/$previous"; fi
    log "Installed docs from $src"
}

cmd_install_docs() {
    local src="${1:?Usage: boxmunge-upgrade install-docs <dir>}"
    [[ "$src" == /* ]] || die "install-docs needs an absolute path (the shim runs from /), not '$src'"
    install_docs "$src" || die "install-docs failed"
}

# seed_slot_docs <slot>: a slot installed by install.sh (or an older shim)
# has no docs copy; record the live docs as its own so a rollback to it
# restores them.
seed_slot_docs() {
    local dest
    dest="$(slot_docs "$1")"
    if [[ ! -d "$dest" ]] && compgen -G "$BOXMUNGE_ROOT/docs/*.md" >/dev/null; then
        mkdir -p "$dest"
        cp "$BOXMUNGE_ROOT/docs/"*.md "$dest/"
    fi
}

# refresh_docs_for_slot <slot>: best effort, because a docs failure must not
# undo an upgrade or a rollback. Logged loudly so it is not missed.
refresh_docs_for_slot() {
    local src
    src="$(slot_docs "$1")"
    if [[ ! -d "$src" ]] || ! install_docs "$src"; then
        log "ERROR: docs not refreshed for slot $1 ($src missing or empty); agent-help may be stale"
        bm_log error upgrade "docs refresh failed" "{\"slot\": \"$1\"}"
    fi
}

# self_update_shim <bundle_dir>: install the bundle's shim (and other bin/
# wrappers) over the running ones. Without this, shim fixes would take effect
# only on the upgrade after they ship. Gated on `bash -n`, and on the shim
# being a built one: a syntactically broken or unbuilt shim would brick
# `boxmunge-upgrade` until install.sh is re-run, so it is refused and the
# running shim kept (the venv install still goes ahead; the fix is just
# deferred to the next release).
self_update_shim() {
    local bundle="$1" new_shim="$1/scripts/boxmunge-upgrade" f name
    if [[ -f "$new_shim" ]]; then
        if ! bash -n "$new_shim" 2>/dev/null; then
            log "ERROR: new shim has syntax errors; refusing to install. Old shim retained."
            bm_log error upgrade "shim self-update skipped: bash -n failed" "{}"
        elif grep -q '^# >>> boxmunge-upgrade.d:' "$new_shim"; then
            log "ERROR: bundle carries an unbuilt source shim; refusing to install. Old shim retained."
            bm_log error upgrade "shim self-update skipped: unbuilt shim" "{}"
        else
            log "Self-updating upgrade shim from bundle..."
            install -m 0755 -o root -g root "$new_shim" "$BIN_DIR/boxmunge-upgrade"
            bm_log info upgrade "shim self-updated" "{}"
        fi
    fi
    # Other wrappers under bin/ the bundle ships. boxmunge-sftp is the SFTP
    # wrapper invoked by sshd (it refuses deploy).
    # shellcheck disable=SC2043  # one wrapper today; new bin/ wrappers go in this list
    for name in boxmunge-sftp; do
        f="$bundle/scripts/$name"
        [[ -f "$f" ]] || continue
        if bash -n "$f" 2>/dev/null; then
            install -m 0755 -o root -g root "$f" "$BIN_DIR/$name"
            bm_log info upgrade "wrapper self-updated" "{\"name\": \"$name\"}"
        else
            log "ERROR: new $name has syntax errors; refusing to install. Old wrapper retained."
            bm_log error upgrade "wrapper self-update skipped: bash -n failed" "{\"name\": \"$name\"}"
        fi
    done
}
# <<< boxmunge-upgrade.d/system.sh

# >>> inlined from boxmunge-upgrade.d/userns.sh by scripts/build-shim.py
# userns.sh — the root-only user-namespace migration (OPERATIONS.md,
# "User-namespace remapping"). The supervisor runs these through sudo; they
# are not in deploy's sudo rule. The Python core (`boxmunge-server userns
# ...`) refuses to run unless it inherits this shim's upgrade.lock.

USERNS_JOURNAL="$UPGRADE_ROOT_DIR/userns-migration.json"
# The first release that understands a remapped daemon. A release before it
# would start the system container in the remapped namespace.
FIRST_USERNS_RELEASE="0.11.0"

# userns_state: "<direction> <phase>" from the journal ("forward commit"
# for an applied migration whose commit began), or nothing when there is
# none. The directory is root-only; the file is still opened
# without following a link.
userns_state() {
    refuse_symlink "$UPGRADE_ROOT_DIR"
    refuse_symlink "$USERNS_JOURNAL"
    [[ -e "$USERNS_JOURNAL" ]] || return 0
    BM_FILE="$USERNS_JOURNAL" python3 -c 'import json, os
fd = os.open(os.environ["BM_FILE"], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
with os.fdopen(fd) as f:
    doc = json.load(f)
d, p = doc["direction"], doc["phase"]
assert isinstance(d, str) and isinstance(p, str) and d.isalpha() and p.replace("-", "").isalpha()
if p == "applied" and "commit-before" in (doc.get("items") or {}):
    p = "commit"
print(d, p)' 2>/dev/null || die "$USERNS_JOURNAL is malformed; inspect it (boxmunge-server userns check)"
}

# userns_guard_target <version>: force-target may not go below the first
# release that understands remapping while the box is remapped.
userns_guard_target() {
    local state
    state="$(userns_state)"
    if [[ "$state" == "forward applied" || "$state" == "forward commit" || "$state" == "forward committed" ]] \
            && semver_lt "$1" "$FIRST_USERNS_RELEASE"; then
        die "Refusing $1: this box's Docker daemon is remapped (userns migration ${state#* }), and releases before $FIRST_USERNS_RELEASE would start the system container in the remapped namespace."
    fi
}

# userns_finish <state>: the subcommand that finishes a stopped <state>.
userns_finish() {
    case "$1" in
        "forward commit") echo "userns-commit" ;;
        rollback\ *) echo "userns-rollback" ;;
        *) echo "userns-migrate (to resume) or userns-rollback" ;;
    esac
}

# userns_refuse_mid_migration <version> <mode>: no upgrade while a migration,
# its rollback or its commit is stopped part-way: an upgrade restarts
# projects, which would start them on data that is only partly shifted, or
# from a store being deleted.
userns_refuse_mid_migration() {
    local state
    state="$(userns_state)"
    case "${state#* }" in
        ""|applied|committed|rolled-back) return 0 ;;
    esac
    bm_log warn upgrade "upgrade deferred: userns migration in progress" "{\"version\": \"$1\"}"
    if [[ "$2" == "run" ]]; then
        log "Not upgrading to $1: a userns $state is in progress. Deferred; auto-update retries on its next run."
        exit 0
    fi
    die "Not upgrading to $1: a userns $state is stopped part-way. Finish it first: sudo $BOXMUNGE_ROOT/bin/boxmunge-upgrade $(userns_finish "$state")."
}

userns_run() {  # userns_run <check|migrate|rollback|commit>
    load_active_slot
    if [[ "$1" != "check" ]]; then
        acquire_lock
        if [[ "$1" == "migrate" ]]; then
            if [[ -e "$(inflight_marker "$ACTIVE_SLOT")" || -e "$(rollback_marker a)" || -e "$(rollback_marker b)" ]]; then
                die "Not migrating: an upgrade or rollback was interrupted; the health timer's check-probation finishes it within minutes. Retry after that."
            fi
            if load_probation; then
                die "Not migrating: $PROB_VERSION is on probation until $PROB_EXPIRES_AT. Migrate after it ends."
            fi
        fi
    fi
    bm_log info userns "userns $1 started" "{}"
    "$(active_venv)/bin/boxmunge-server" userns "$1"
}

cmd_userns_migrate() {
    case "$#:${1:-}" in
        0:) userns_run migrate ;;
        1:--check) userns_run check ;;
        *) die "Usage: boxmunge-upgrade userns-migrate [--check]" ;;
    esac
}

cmd_userns_rollback() { [[ $# -eq 0 ]] || die "Usage: boxmunge-upgrade userns-rollback"; userns_run rollback; }
cmd_userns_commit() { [[ $# -eq 0 ]] || die "Usage: boxmunge-upgrade userns-commit"; userns_run commit; }
# <<< boxmunge-upgrade.d/userns.sh

# preflight_fail <version> <from_version> <blocklist_reason> <message> [stage]
#
# Abort before the slot swap: drop the half-built standby venv, blocklist
# the version so auto-update stops retrying it, and report the failure.
preflight_fail() {
    log "$4"
    remove_slot "$(standby_slot)"
    add_blocklist "$1" "$3"
    report_failure "$1" "$2" "${5:-preflight}"
    exit 1
}

# dependency_install_failed <version> <from_version>: pip could not install
# the bundle's hash-pinned dependencies. That is rarely the release's fault
# (a network blip, the disk filling mid-install), so, as for an interrupted
# upgrade, the first failure of a version is not blocklisted or reported to
# the fleet service and auto-update retries it; a second in a row is.
dependency_install_failed() {
    local version="$1" from_version="$2" count
    count=$(( $(pip_failures "$version") + 1 ))
    pip_failures "$version" "$count"
    [[ "$count" -lt 2 ]] || preflight_fail "$version" "$from_version" "preflight_failed: pip_install_deps" \
        "Failed to install hash-pinned dependencies from bundle ($count times in a row); blocklisting $version"
    log "Failed to install hash-pinned dependencies from bundle; not blocklisted, auto-update will retry $version"
    remove_slot "$(standby_slot)"
    bm_log warn upgrade "dependency install failed" "{\"version\": \"$version\", \"failures\": $count}"
    send_notification "boxmunge upgrade failed" "Could not install the dependencies of $version (not blocklisted; auto-update will retry it)"
    exit 1
}

# stash_failed <version> <output>: the platform stash was refused (a symlink
# it cannot hold) or failed (a full disk) before anything changed. That is the
# box's doing, not the release's, so the version is not blocklisted or
# reported; the standby is dropped and the operator alerted, so an unattended
# auto-update stopping here every run is seen.
stash_failed() {
    local version="$1" output="$2"
    log "Stash creation failed, aborting; $version not blocklisted: $output"
    remove_slot "$(standby_slot)"
    bm_log error upgrade "upgrade to $version aborted before any change: stash creation failed: $output" \
        "{\"version\": \"$version\"}"
    send_notification "boxmunge upgrade failed" \
        "The platform stash failed, so the upgrade to $version stopped before changing anything (not blocklisted; auto-update will retry it). Fix this and retry: $output"
    exit 1
}

TMP_DOWNLOAD=""
cleanup_download() { [[ -z "$TMP_DOWNLOAD" ]] || rm -rf "$TMP_DOWNLOAD"; }

cmd_run() {
    local version="${1:?Usage: boxmunge-upgrade run <version> <url>}"
    : "${2:?Usage: boxmunge-upgrade run <version> <url>}"
    upgrade_to "$version" run
}

# upgrade_to <version> <mode>: the upgrade itself, after the policy check.
upgrade_to() {
    local version="$1" mode="$2"

    load_active_slot
    acquire_lock
    check_policy "$version" "$mode"
    refuse_during_probation "$version" "$mode"
    userns_refuse_mid_migration "$version" "$mode"
    [[ "$mode" != "force" ]] || userns_guard_target "$version"
    cmd_install_sudoers
    seed_slot_docs "$ACTIVE_SLOT"

    local prev_slot from_version standby
    prev_slot="$ACTIVE_SLOT"
    from_version="$("$(active_venv)/bin/boxmunge-server" --version 2>/dev/null || echo "unknown")"
    standby="$(standby_slot)"

    # 1. PREPARE
    log "Preparing standby venv (slot $standby)..."
    # A slot is about 90MB on Debian, MCP included. pip runs with
    # --no-cache-dir, so no wheel cache builds up under /root; the rest is
    # headroom for the stash.
    local avail_mb
    avail_mb=$(df -m "$BOXMUNGE_ROOT" | awk 'NR==2{print $4}')
    [[ "$avail_mb" -lt 250 ]] && die "Insufficient disk space: ${avail_mb}MB available, need 250MB"

    remove_slot "$standby"
    python3 -m venv "$BOXMUNGE_ROOT/env-$standby"

    # Download bundle from GitHub release
    local tmp_download
    TMP_DOWNLOAD="$(mktemp -d)"
    tmp_download="$TMP_DOWNLOAD"
    trap cleanup_download EXIT
    local release_base="https://github.com/boxmunge/boxmunge/releases/download/v${version}"
    local bundle_url="${release_base}/boxmunge-${version}.tar.gz"
    local sums_url="${release_base}/SHA256SUMS"
    local sums_sig_url="${release_base}/SHA256SUMS.sig"
    local sums_cert_url="${release_base}/SHA256SUMS.cert"

    log "Downloading bundle from ${bundle_url}"
    curl -sLf -o "$tmp_download/boxmunge-${version}.tar.gz" "$bundle_url" \
        || preflight_fail "$version" "$from_version" "preflight_failed: bundle_download" \
            "Failed to download bundle"
    curl -sLf -o "$tmp_download/SHA256SUMS" "$sums_url" \
        || preflight_fail "$version" "$from_version" "preflight_failed: checksum_download" \
            "Failed to download SHA256SUMS"
    curl -sLf -o "$tmp_download/SHA256SUMS.sig" "$sums_sig_url" \
        || preflight_fail "$version" "$from_version" "preflight_failed: signature_download" \
            "Failed to download SHA256SUMS.sig (release is unsigned or sig artifact missing)"
    curl -sLf -o "$tmp_download/SHA256SUMS.cert" "$sums_cert_url" \
        || preflight_fail "$version" "$from_version" "preflight_failed: certificate_download" \
            "Failed to download SHA256SUMS.cert (release is unsigned or cert artifact missing)"

    # Verify cosign signature on SHA256SUMS BEFORE running sha256sum -c.
    #
    # This breaks the circularity of the prior design (where SHA256SUMS and
    # the bundle came from the same release URL — an attacker who replaced
    # the bundle could replace SHA256SUMS in lockstep). Cosign's keyless
    # signature chains to a Fulcio cert tying SHA256SUMS to the release
    # workflow on a tagged release of this exact repo; without the OIDC
    # issuer pinning the attacker would need to compromise GitHub Actions
    # OIDC, not just the release artifacts.
    #
    # cosign is hard-required: if the host is missing it, abort.
    if ! verify_release_signature "$tmp_download"; then
        preflight_fail "$version" "$from_version" "preflight_failed: cosign_verify" \
            "Cosign verification of SHA256SUMS FAILED — refusing to install."
    fi
    log "Cosign signature on SHA256SUMS verified (release-workflow identity)"
    bm_log info upgrade "signature verified" "{\"version\": \"$version\"}"

    # Verify checksum.
    #
    # SHA256SUMS lines are produced by `sha256sum <file>` and have the
    # canonical form: `<64-hex-hash>  <filename>` (two spaces, bare filename
    # — the release workflow takes care to write bare filenames).
    #
    # We do NOT pass --ignore-missing: it makes `sha256sum -c` succeed when
    # the SHA256SUMS file lists zero matching files. An adversary who could
    # publish a SHA256SUMS without a line for our bundle would then pass
    # verification trivially. So instead we (a) require that SHA256SUMS
    # contains a line for the exact bundle filename we just downloaded, and
    # (b) run the full check.
    local expected_filename="boxmunge-${version}.tar.gz"
    if ! grep -q "  ${expected_filename}\$" "${tmp_download}/SHA256SUMS"; then
        preflight_fail "$version" "$from_version" "preflight_failed: checksum_missing_entry" \
            "Checksum verification FAILED: SHA256SUMS does not list ${expected_filename}"
    fi
    # SHA256SUMS may also list boxmunge-install.sh and other release artefacts
    # we did not download; restrict the check to just the bundle line.
    (cd "$tmp_download" && grep "  ${expected_filename}\$" SHA256SUMS | sha256sum -c -) \
        || preflight_fail "$version" "$from_version" "preflight_failed: checksum_mismatch" \
            "Checksum verification FAILED"

    # Extract and pip install
    tar xzf "$tmp_download/boxmunge-${version}.tar.gz" -C "$tmp_download"
    # Dependencies only from the bundle's hash-pinned requirements (covered by
    # the signed SHA256SUMS); the package itself with no further resolution,
    # built by the hash-pinned backend. No pip self-upgrade: one more
    # unpinned download. MCP is part of every install: the slot is built from
    # scratch, so anything not installed here is gone after the swap.
    local bundle="$tmp_download/boxmunge" req reqs=()
    for req in requirements-build.txt requirements-tui.txt requirements-mcp.txt; do
        [[ -f "$bundle/$req" ]] \
            || preflight_fail "$version" "$from_version" "preflight_failed: no_pinned_requirements" \
                "Bundle has no hash-pinned $req; refusing an unpinned install"
        reqs+=(-r "$bundle/$req")
    done
    "$BOXMUNGE_ROOT/env-$standby/bin/pip" install --quiet --no-cache-dir --require-hashes "${reqs[@]}" \
        || dependency_install_failed "$version" "$from_version"
    pip_failures "$version" 0
    "$BOXMUNGE_ROOT/env-$standby/bin/pip" install --quiet --no-cache-dir --no-deps --no-build-isolation "$bundle" \
        || preflight_fail "$version" "$from_version" "preflight_failed: pip_install" \
            "Failed to install boxmunge from bundle"
    compgen -G "$tmp_download/boxmunge/on-server/*.md" >/dev/null \
        || preflight_fail "$version" "$from_version" "preflight_failed: bundle_docs" \
            "Bundle has no on-server/*.md docs"
    mkdir -p "$(slot_docs "$standby")"
    cp "$tmp_download/boxmunge/on-server/"*.md "$(slot_docs "$standby")/"

    # 2. PRE-FLIGHT
    log "Running pre-flight checks..."

    # Pre-flight import test: verify the new venv can import boxmunge and
    # report a non-empty version. v0.9.0 dropped the stale
    # `boxmunge.__version__` constant (drift-prone, not actually the source
    # of truth) — read from `boxmunge.version.get_build_version()` instead,
    # which has been the canonical accessor since v0.5.
    "$BOXMUNGE_ROOT/env-$standby/bin/python" -c "from boxmunge.version import get_build_version; print(get_build_version())" \
        || preflight_fail "$version" "$from_version" "preflight_failed: import" \
            "Pre-flight FAILED: import test"

    "$BOXMUNGE_ROOT/env-$standby/bin/boxmunge-server" --version >/dev/null 2>&1 \
        || preflight_fail "$version" "$from_version" "preflight_failed: cli_version" \
            "Pre-flight FAILED: CLI version check"

    "$BOXMUNGE_ROOT/env-$standby/bin/boxmunge-server" upgrade --dry-run \
        || preflight_fail "$version" "$from_version" "preflight_failed: dry_run" \
            "Pre-flight FAILED: dry-run upgrade"

    log "Pre-flight passed"

    # 3. STASH (using active/trusted venv)
    log "Creating platform stash..."
    local stash_out
    stash_out="$("$(active_venv)/bin/boxmunge-server" stash create 2>&1)" \
        || stash_failed "$version" "$stash_out"
    log "$stash_out"

    # 3a. Refresh tree-level templates that aren't shipped in the venv.
    # Today: the canary project, used by `boxmunge self-test`. Without this,
    # an auto-updated host has no /opt/boxmunge/canary and self-test errors.
    # Runs as root; perms aren't a concern. Overwrite any prior dir.
    if [[ -d "$tmp_download/boxmunge/canary" ]]; then
        log "Refreshing /opt/boxmunge/canary from bundle..."
        rm -rf "$BOXMUNGE_ROOT/canary"
        cp -r "$tmp_download/boxmunge/canary" "$BOXMUNGE_ROOT/canary"
        chown -R root:root "$BOXMUNGE_ROOT/canary"
        bm_log info upgrade "canary refreshed" "{\"version\": \"$version\"}"
    fi

    # 3b. Self-update the upgrade shim and its libraries (see self_update_shim).
    self_update_shim "$tmp_download/boxmunge"

    # 3c. System upgrade (install.sh re-run).
    #
    # Closes the v0.6.x gap where new system deps (Trivy, new systemd timers,
    # apt packages) silently required a manual install.sh re-run after every
    # auto-update. install.sh writes its own sha256 to state/installer.sha256
    # at the end of every successful run — when the bundled install.sh differs
    # from the on-disk fingerprint, we re-invoke it BEFORE the slot swap so
    # system-level dependencies are in place by the time the new venv goes
    # active. install.sh is hard-gated on `bash -n` for the same reason as
    # the shim self-update above: a syntactically broken install.sh in a
    # future release must NOT brick this host.
    #
    # On install.sh failure: fail noisily before the swap, blocklist this
    # version, and exit. The prior venv stays active and the prior shim
    # stays in place (we already swapped the shim above, but the new shim
    # is meant to be backwards-compatible with the old layout). Operator
    # diagnoses, fixes manually, and clears the blocklist.
    #
    # Missing-fingerprint case (first upgrade past this feature): treated
    # as "needs upgrade" — install.sh re-runs, writes the fingerprint, and
    # subsequent upgrades only re-run when the bundle changes install.sh.
    local new_install_sh="$tmp_download/boxmunge/install.sh"
    local installer_hash_file="$BOXMUNGE_ROOT/state/installer.sha256"
    if [[ -f "$new_install_sh" ]]; then
        if ! bash -n "$new_install_sh" 2>/dev/null; then
            bm_log error upgrade "system upgrade skipped: bash -n failed" "{\"version\": \"$version\"}"
            preflight_fail "$version" "$from_version" "system_upgrade_failed: install_sh_syntax" \
                "ERROR: bundled install.sh has syntax errors; refusing to run system upgrade" system_upgrade
        fi
        local new_hash current_hash
        new_hash="$( (cd "$tmp_download/boxmunge" && find . \( -path ./install.sh -o -path './bootstrap/*' -o -path './src/boxmunge/sshd/*' \) -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum) | sha256sum | awk '{print $1}')"
        current_hash="$(cat "$installer_hash_file" 2>/dev/null || echo "")"
        if [[ "$new_hash" != "$current_hash" ]]; then
            log "install.sh changed (current=${current_hash:0:8}, new=${new_hash:0:8}); running system upgrade..."
            bm_log info upgrade "system upgrade started" "{\"new_hash\": \"${new_hash:0:16}\", \"prev_hash\": \"${current_hash:0:16}\"}"
            local sysup_exit=0
            bash "$new_install_sh" --upgrade-shim || sysup_exit=$?
            if [[ "$sysup_exit" -eq 0 ]]; then
                bm_log info upgrade "system upgrade completed" "{\"hash\": \"${new_hash:0:16}\"}"
            else
                bm_log error upgrade "system upgrade failed" "{\"exit_code\": $sysup_exit}"
                preflight_fail "$version" "$from_version" "system_upgrade_failed: install_sh_exit_${sysup_exit}" \
                    "ERROR: install.sh failed (exit ${sysup_exit}); aborting upgrade before slot swap" system_upgrade
            fi
        else
            log "install.sh unchanged (${new_hash:0:8}); skipping system upgrade"
        fi
    fi

    # 4. SWAP. Until probation is recorded, the marker is what keeps
    # check-probation from deleting the previous slot as an orphan after a
    # crash; it is synced to disk before the new slot can go live.
    echo "$version" > "$(inflight_marker "$standby")"
    sync
    log "Swapping to standby venv (slot $standby)..."
    swap_to "$standby"

    # 5. APPLY (using new active venv)
    log "Applying upgrade..."
    "$(active_venv)/bin/boxmunge-server" upgrade --apply || {
        do_rollback "$version" "$from_version" "apply" "$prev_slot"
    }

    # 6. VERIFY
    log "Running health check..."
    # Bound the immediate post-swap health check. A wedged docker socket
    # or stuck subprocess could otherwise hang here indefinitely. Use
    # --kill-after=10 to escalate SIGTERM -> SIGKILL if the process refuses
    # to die. Budget is shorter than probation's 180s because this is the
    # post-swap quick check; probation does the long-running validation.
    local health_exit=0
    timeout --kill-after=10 60 "$(active_venv)/bin/boxmunge-server" health --json >/dev/null 2>&1 || health_exit=$?
    if [[ "$health_exit" -eq 2 ]]; then
        do_rollback "$version" "$from_version" "health_immediate" "$prev_slot"
    fi

    # 7. ENTER PROBATION
    log "Entering probation for $version..."
    BM_VERSION="$version" BM_PREV_SLOT="$prev_slot" BM_HOURS="$PROBATION_HOURS" "$(active_venv)/bin/python" -c "
import os
from boxmunge.upgrade_state import write_probation
from boxmunge.paths import BoxPaths
write_probation(BoxPaths(), os.environ['BM_VERSION'], os.environ['BM_PREV_SLOT'], hours=int(os.environ['BM_HOURS']))
"
    bm_log info upgrade "probation entered" "{\"version\": \"$version\", \"prev_slot\": \"$prev_slot\", \"hours\": $PROBATION_HOURS}"
    rm -f "$(inflight_marker "$ACTIVE_SLOT")"
    refresh_docs_for_slot "$ACTIVE_SLOT"

    send_notification "boxmunge security update applied" "Updated to $version (probation: ${PROBATION_HOURS}h)"
    log "Upgrade to $version complete, probation started"
    exit 0
}

cmd_auto() {
    local result action version msg
    load_active_slot
    acquire_lock  # before discovery, and held through the upgrade itself
    result="$("$(active_venv)/bin/boxmunge-server" _discover-update --json 2>/dev/null)" || \
        die "Discovery failed (boxmunge-server _discover-update returned non-zero)"

    action="$(echo "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("action",""))')"

    case "$action" in
        upgrade)
            version="$(echo "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin)["version"])')"
            log "Manual upgrade: discovered $(printable "$version")"
            upgrade_to "$version" run
            ;;
        up_to_date)
            log "Already on latest version"
            exit 0
            ;;
        blocklisted)
            log "Latest version is blocklisted on this box; nothing to do"
            exit 0
            ;;
        error)
            msg="$(echo "$result" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("message","(no message)"))')"
            die "Discovery error: $msg"
            ;;
        *)
            die "Unknown action from _discover-update: $action"
            ;;
    esac
}

# target <version>: reachable by deploy through sudo, so exactly one argument
# (sudo's `target *` would otherwise let extra words through).
cmd_target() {
    [[ $# -eq 1 ]] || die "Usage: boxmunge-upgrade target <version>"
    require_semver "$1" "requested version"
    log "Targeted upgrade: $1"
    upgrade_to "$1" target
}

cmd_force_target() {
    [[ $# -eq 1 ]] || die "Usage: boxmunge-upgrade force-target <version>"
    require_semver "$1" "requested version"
    log "Operator-forced upgrade: $1"
    upgrade_to "$1" force
}

cmd_clear_blocklist() {
    local version="${1:?Usage: boxmunge-upgrade clear-blocklist <version>}"
    require_semver "$version" "requested version"
    load_active_slot
    BM_VERSION="$version" "$(active_venv)/bin/python" -c "
import os
from boxmunge.upgrade_state import remove_from_blocklist
from boxmunge.paths import BoxPaths
remove_from_blocklist(BoxPaths(), os.environ['BM_VERSION'])
"
    interruptions "$version" 0
    pip_failures "$version" 0
    log "Cleared $version from blocklist"
}

case "${1:-}" in
    run)             shift; cmd_run "$@" ;;
    auto)            [[ $# -eq 1 ]] || die "Usage: boxmunge-upgrade auto"; cmd_auto ;;
    target)          shift; cmd_target "$@" ;;
    force-target)    shift; cmd_force_target "$@" ;;
    check-probation) cmd_check_probation ;;
    clear-blocklist) shift; cmd_clear_blocklist "$@" ;;
    install-sudoers) cmd_install_sudoers ;;
    install-docs)    shift; cmd_install_docs "$@" ;;
    userns-migrate)  shift; cmd_userns_migrate "$@" ;;
    userns-rollback) shift; cmd_userns_rollback "$@" ;;
    userns-commit)   shift; cmd_userns_commit "$@" ;;
    *)               die "Usage: boxmunge-upgrade {run|auto|target|force-target|check-probation|clear-blocklist|install-sudoers|install-docs|userns-migrate|userns-rollback|userns-commit} [args]" ;;
esac
