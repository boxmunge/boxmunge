# boxmunge host configuration: a reference copy of the keys
# /opt/boxmunge/config/boxmunge.yml accepts. bootstrap/init-host.sh writes
# most of them at install; the rest (container_updates, auto_update,
# version_check) take
# the defaults in src/boxmunge/config.py until set, kev takes those in
# src/boxmunge/cve/kev.py, and webhooks are off until set. Edited by hand,
# as root. Every value is checked: `health` lists a setting of the wrong
# type or out of range under host-config, the commands you run by hand
# refuse until it is corrected, and a timer's job refuses only if it reads
# that setting.

hostname: __HOSTNAME__
ssh_port: 922
# Required. Install also writes it into caddy/Caddyfile as the ACME contact;
# changing it here does not change Caddy's.
admin_email: __ADMIN_EMAIL__

pushover:
  user_key: ""
  app_token: ""

backup_remote: ""

# alert_threshold: failed checks in a row before a project alerts. The
# other health, reboot and logging values are recorded at install, and
# changing them changes nothing: the health timer runs every 5 minutes
# (boxmunge-health.timer), unattended-upgrades reboots in the window set in
# /etc/apt/apt.conf.d/20auto-upgrades, and Docker rotates container logs as
# /etc/docker/daemon.json says.
health:
  check_interval_minutes: 5
  alert_threshold: 3

reboot:
  auto_reboot: true
  reboot_window: "04:00"

logging:
  docker_max_size: "50m"
  docker_max_file: 5

# Daily container updates (the container-update timer): re-pull and recreate
# Caddy and every project's image: services. A project opts out in its
# manifest with container_updates: {enabled: false}. strategy is
# leave_broken or rollback_to_previous.
container_updates:
  enabled: true
  strategy: leave_broken

# Platform auto-update (the auto-update timer, every 6 hours).
# Security releases are always applied automatically. Break-fix releases
# (critical non-security fixes) are applied automatically unless breakfix
# is false. Feature releases are never auto-applied; run `upgrade`.
# breakfix must be true or false.
auto_update:
  breakfix: true

# The version-check service at boxmunge.dev: the box asks it for releases
# (auto-update every 6 hours, and a plain `upgrade`) and reports failed
# upgrades to it. enabled: false stops both, and the GitHub fallback too:
# the box then discovers no releases, so security releases are NOT
# installed automatically, and `health` and `doctor` say so. Install a
# release by hand with `upgrade --target X.Y.Z`. Must be true or false.
version_check:
  enabled: true

# CISA KEV catalog sources, tried in order before each CVE scan; the first
# whose catalog passes the sanity checks is cached, and `boxmunge security`
# shows which one answered. The default is CISA's feed, then CISA's own
# mirror on GitHub (for address ranges CISA's CDN refuses). Set sources to
# replace the list; each must be an https:// URL serving the same JSON. A
# mistake here fails only the KEV refresh, which alerts naming it.
# kev:
#   sources:
#     - https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
#     - https://raw.githubusercontent.com/cisagov/kev-data/main/known_exploited_vulnerabilities.json

# Optional webhooks: a JSON POST (event, project, timestamp, hostname,
# details) to each url whose events list the event. Events: deploy, stage,
# promote, unstage, rollback. One event may be given on its own
# (`events: deploy`). Delivery is best-effort; a failure is logged. A hook
# that is not of this form is skipped, and the others still fire.
# webhooks:
#   - url: https://hooks.example.com/boxmunge
#     events: [deploy, promote, rollback]

# userns: {name, offset} is written by install and by
# `boxmunge-upgrade userns-migrate`. Never edit it by hand.
