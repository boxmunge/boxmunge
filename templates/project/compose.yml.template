# Docker Compose file for __PROJECT_NAME__
#
# boxmunge will generate compose.boxmunge.yml to handle proxy networking.
# Do NOT add boxmunge-proxy network config here — keep this file portable.

services:
  frontend:
    build: ./repo/frontend
    # image: your-registry/__PROJECT_NAME__-frontend:latest
    restart: unless-stopped
    env_file:
      - project.env
    # No ports: here. Caddy is the only ingress; a port that must be
    # reachable from the host goes in manifest.yml under
    # security.published_ports (published on 127.0.0.1, with a reason).
    volumes:
      - ./data/frontend:/app/data

