# Environment variables for __PROJECT_NAME__
# Copy this to project.env and adjust. boxmunge adds project.env to every
# service manifest.yml declares; list it under env_file: for the others.
#
# Non-secret configuration only. Set credentials on the server, where they
# are kept in the project's secrets.env, outside the repository:
#   boxmunge secrets set __PROJECT_NAME__ DATABASE_URL=postgresql://...

# Example variables (adjust for your project):
# NODE_ENV=production
# LOG_LEVEL=info
# POSTGRES_USER=app
# POSTGRES_DB=appdb
