[Unit]
Description=boxmunge KEV watch (rescan projects hit by a newly listed exploited CVE)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/boxmunge/bin/boxmunge security kev-watch
StandardOutput=journal
StandardError=journal
# Bounds how long the nightly scan can wait on a stuck tick (it holds the
# fleet lock); the maintenance unit's 5h still fits scan plus update.
TimeoutStartSec=1h
