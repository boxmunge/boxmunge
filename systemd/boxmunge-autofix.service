[Unit]
Description=boxmunge urgent autofix (patch the queued known-exploited findings)
After=docker.service
Requires=docker.service

[Service]
# No timer: the nightly scan, the KEV watch and a supervisor's single-project
# scan start it (systemctl start --no-block) when they queue a patch. systemd
# never runs two at once; the run goes round the queue until it is empty. It
# takes project locks only, never the CVE fleet lock, so patching does not
# hold up the scans.
Type=oneshot
User=root
ExecStart=/opt/boxmunge/bin/boxmunge security autofix-queue
StandardOutput=journal
StandardError=journal
TimeoutStartSec=6h
